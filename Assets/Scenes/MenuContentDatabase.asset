          dialogue:
            id: chapter_1_scene_1_phase_2_trigger_2_dialogue
            title: "Combat - th\u1EF1c hi\u1EC7n ngay sau khi \u0111\xF2n \xE1nh
              s\xE1ng \u0111en k\xE9o nh\xE2n v\u1EADt elio xu\u1ED1ng c\xF2n 10%hp"
            summary: "ti\u1EBFp t\u1EE5c tr\u1EADn chi\u1EBFn, h\u1ED3i hp c\u1EE7a
              elio l\xEAn 35%, reset b\u1ED9 \u0111\u1EBFm qu\xE1i con b\u1ECB ti\xEAu
              di\u1EC7t v\u1EC1 0"
            beats:
            - speaker: 
              text: "M\u1ED9t lu\u1ED3ng ma l\u1EF1c \u0111en \u0111\xE1nh th\u1EB3ng
                v\xE0o l\u01B0ng Elio."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
