          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Elio
          text: "\u0110i th\xF4i. Ta \u0111\u01B0a hai ng\u01B0\u1EDDi t\u1EDBi di\u1EC7n
            ki\u1EBFn ho\xE0ng m\u1EABu."
