          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "Ta bi\u1EBFt n\u01A1i \u0111\xF3 l\u01B0u gi\u1EEF nh\u1EEFng g\xEC."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
