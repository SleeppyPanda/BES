              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "M\u1ED9t ti\u1EBFng kh\xF3c vang l\xEAn b\xEAn tr\xE1i.\nM\u1ED9t
                \u0111\u1EE9a tr\u1EBB b\u1ECB m\u1EAFc k\u1EB9t d\u01B0\u1EDBi xe
                h\xE0ng.\nElio l\u1EADp t\u1EE9c lao t\u1EDBi."
