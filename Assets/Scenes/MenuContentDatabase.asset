            m_PersistentCalls:
              m_Calls: []
        - speaker: Sahure
          text: "Qu\u1EA3 nhi\xEAn v\u1EABn ch\u1EC9 l\xE0 \u0111\u1EE9a tr\u1EBB
            , ch\u1EC9 c\u1EA7n th\u1EA5y th\u1EE9 g\xEC hay th\xEC l\u1EA1i \u0111em
            v\u1EC1 nh\xE0"
