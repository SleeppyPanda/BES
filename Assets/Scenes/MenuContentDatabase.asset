              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Elio
              text: "\xCDt nh\u1EA5t ta c\xF3 th\u1EC3 tin r\u1EB1ng m\u1ED9t ng\u01B0\u1EDDi
                l\xE0m v\u1EADy kh\xF4ng c\xF3 \xFD \u0111\u1ECBnh gi\u1EBFt ta ngay
                l\xFAc n\xE0y , v\u1EDBi l\u1EA1i , ta kh\xF4ng ph\u1EA3i k\u1EBB
                v\xF4 \u01A1n t\u1EDBi m\u1EE9c kh\xF4ng bi\u1EBFt \u0111\xE1p l\u1EC5
                ng\u01B0\u1EDDi m\u1EDBi gi\xFAp m\xECnh ."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
