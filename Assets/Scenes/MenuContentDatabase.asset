            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Con c\xF2n qu\xE1 y\u1EBFu \u0111\u1EC3 ti\u1EBFp nh\u1EADn H\u1ECFa
            \u1EA4n.\nCh\u01B0a \u0111\u1EE7 t\u01B0 c\xE1ch \u0111\u1EC3 tr\u1EDF
            th\xE0nh ng\u01B0\u1EDDi cai tr\u1ECB Akherat."
