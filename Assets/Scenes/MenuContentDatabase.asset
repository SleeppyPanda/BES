              m_Calls: []
        - speaker: Lunen
          text: "Sau \u0111\xF3 ch\xFAng t\xF4i b\u1ECB ma v\u1EADt t\u1EADp k\xEDch.
            Elio m\u1EDDi ch\xFAng t\xF4i v\u1EC1 \u0111\xE2y. Ch\u1EC9 v\u1EADy
            th\xF4i."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
