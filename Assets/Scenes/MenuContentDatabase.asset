        - speaker: 
          text: "Hai tai n\xF3 l\u1EADp t\u1EE9c c\u1EE5p xu\u1ED1ng.\nThi\u1EBFu
            ni\xEAn ch\u1EC9 v\u1EC1 ph\xEDa Lunen."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
