              m_Calls: []
        - speaker: Aurelian
          text: "Kh\xF4ng c\u1EA7n."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "Ta \u0111\u1ED3ng \xFD v\xEC ch\xEDnh ta c\u0169ng mu\u1ED1n bi\u1EBFt
            chi\u1EBFc v\xF2ng \u0111\xF3 l\xE0 g\xEC."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "B\u1EEFa ti\u1EC7c ti\u1EBFp t\u1EE5c \u0111\u01B0\u1EE3c m\u1ED9t
            l\xFAc. Sau \u0111\xF3, Elio r\u1EDDi kh\u1ECFi \u0111\u1EA1i \u0111i\u1EC7n.\nLunen
            c\u0169ng c\u1EA3m th\u1EA5y kh\xF4ng kh\xED b\xEAn trong h\u01A1i ng\u1ED9t
            ng\u1EA1t n\xEAn \u0111i ra h\xE0nh lang. C\u1EADu b\u1EAFt g\u1EB7p
            Elio \u0111ang \u0111\u1EE9ng b\xEAn lan can, nh\xECn xu\u1ED1ng th\xE0nh
            ph\u1ED1."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
