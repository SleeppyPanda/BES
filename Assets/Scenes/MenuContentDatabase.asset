          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Rashad \u0111\u01B0a m\u1EAFt v\u1EC1 ph\xEDa b\u1EE9c ph\xF9 \u0111i\xEAu
            cu\u1ED1i c\xF9ng. Tr\xEAn \u0111\xF3, h\xECnh d\xE1ng c\u1EE7a m\u1ED9t
            con ng\u01B0\u1EDDi \u0111ang \u0111\u1EE9ng gi\u1EEFa bi\u1EC3n l\u1EEDa,
            hai tay \xF4m l\u1EA5y m\u1ED9t v\u1EA7ng th\xE1i d\u01B0\u01A1ng."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "Ng\u01B0\u1EDDi \u0111\xE1nh b\u1EA1i s\u1EE9c n\xF3ng \u0111\xE3
            thi\xEAu \u0111\u1ED1t v\xF9ng \u0111\u1EA5t n\xE0y, h\u1EA5p th\u1EE5
            ng\u1ECDn l\u1EEDa c\u1EE7a th\xE1i d\u01B0\u01A1ng v\xE0o ch\xEDnh c\u01A1
            th\u1EC3 m\xECnh v\xE0 tr\u1EDF th\xE0nh H\u1ECFa th\u1EA7n \u0111\u1EA7u
            ti\xEAn c\u1EE7a Akherat."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
