              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Ch\u1EC9 m\u1ED9t c\xE2u ng\u1EAFn.\nLunen l\u1EADp t\u1EE9c
                quay tr\u1EDF l\u1EA1i tr\u1EADn chi\u1EBFn.\nThi\u1EBFu ni\xEAn
                nh\xECn b\xF3ng l\u01B0ng c\u1EADu trong m\u1ED9t tho\xE1ng, r\u1ED3i
                kh\xF3e m\xF4i kh\u1EBD cong l\xEAn."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
