          unitId: 
          pauseCombat: 1
          actionAfterDialogue: 0
          convertUnitId: 
          dialogue:
            id: chapter_1_scene_1_phase_1_trigger_1_dialogue
            title: "Combat - c\xF2n 2 enemy th\u1EF1c hi\u1EC7n ngay khi c\xF3 2
              enemy ch\u1EBFt."
            summary: "ti\u1EBFp t\u1EE5c combat"
            beats:
            - speaker: 
              text: "Ti\u1EBFng kim lo\u1EA1i va ch\u1EA1m vang d\u1ED9i gi\u1EEFa
                r\u1EEBng. Thi\u1EBFu ni\xEAn chi\u1EBFn \u0111\u1EA5u ho\xE0n to\xE0n
                kh\xE1c v\u1EDBi l\xFAc giao tranh c\xF9ng Lunen. Kh\xF4ng c\xF2n
                nh\u1EEFng \u0111\xF2n th\u0103m d\xF2 hay s\u1EF1 ki\u1EC1m ch\u1EBF.
                M\u1ED7i nh\xE1t ch\xE9m \u0111\u1EC1u d\u1EE9t kho\xE1t, tr\u1EF1c
                di\u1EC7n v\xE0 mang theo s\xE1t kh\xED r\xF5 r\u1EC7t. Ng\u1ECDn
                l\u1EEDa qu\xE9t ngang qua m\u1EB7t \u0111\u1EA5t, thi\xEAu ch\xE1y
                t\u1EEBng l\u1EDBp l\xE1 kh\xF4 d\u01B0\u1EDBi ch\xE2n."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Lunen h\u1EA1 g\u1EE5c m\u1ED9t ma v\u1EADt \u0111ang lao t\u1EDBi
                t\u1EEB b\xEAn ph\u1EA3i r\u1ED3i xoay ng\u01B0\u1EDDi ch\u1EB7n
                \u0111\xF2n \u0111\xE1nh kh\xE1c. Trong kho\u1EA3nh kh\u1EAFc ng\u1EAFn
                ng\u1EE7i \u1EA5y, c\u1EADu nghe th\u1EA5y nh\u1EEFng \xE2m thanh
                k\u1EF3 l\u1EA1 ph\xE1t ra t\u1EEB ph\xEDa \u0111\u1ED1i ph\u01B0\u01A1ng."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Ban \u0111\u1EA7u ch\u1EC9 gi\u1ED1ng nh\u1EEFng ti\u1EBFng
                g\u1EA7m v\xF4 ngh\u0129a.\nNh\u01B0ng khi m\u1ED9t ma v\u1EADt ti\u1EBFn
                s\xE1t h\u01A1n, nh\u1EEFng t\u1EEB ng\u1EEF m\xE9o m\xF3 b\u1EAFt
                \u0111\u1EA7u tr\u1EDF n\xEAn r\xF5 r\xE0ng."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "...:\n...v\u01B0\u01A1ng t\u1EED..."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Lunen kh\u1EF1ng l\u1EA1i.\nM\u1ED9t con kh\xE1c l\u1EA9m b\u1EA9m
                qua h\xE0m r\u0103ng nghi\u1EBFn ch\u1EB7t."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "...:\n...truy s\xE1t... v\u01B0\u01A1ng t\u1EED..."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "R\u1ED3i m\u1ED9t gi\u1ECDng kh\xE1c vang l\xEAn, kh\xE0n \u0111\u1EE5c
                v\xE0 r\u1EDDi r\u1EA1c."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "...:\n...v\u01B0\u01A1ng tri\u1EC1u... ph\u1EA3i ch\u1EBFt..."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "\u0110\xE1m ma v\u1EADt kh\xF4ng t\u1EA5n c\xF4ng m\u1ED9t c\xE1ch
                ng\u1EABu nhi\xEAn.\nPh\u1EA7n l\u1EDBn ch\xFAng \u0111\u1EC1u \u0111ang
                c\u1ED1 v\u01B0\u1EE3t qua Lunen \u0111\u1EC3 lao th\u1EB3ng v\u1EC1
                ph\xEDa ng\u01B0\u1EDDi thi\u1EBFu ni\xEAn t\xF3c \u0111en."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Lunen
              text: "C\u1EA9n th\u1EADn!"
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 0
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Thi\u1EBFu ni\xEAn v\u1EEBa h\u1EA1 g\u1EE5c m\u1ED9t con tr\u01B0\u1EDBc
                m\u1EB7t th\xEC m\u1ED9t ma v\u1EADt kh\xE1c b\u1EA5t ng\u1EDD lao
                ra t\u1EEB ph\xEDa sau. N\xF3 gi\u01A1 cao l\u01B0\u1EE1i gi\xE1o
                \u0111en, nh\u1EAFm th\u1EB3ng v\xE0o kho\u1EA3ng tr\u1ED1ng sau
                l\u01B0ng c\u1EADu.\nThi\u1EBFu ni\xEAn quay l\u1EA1i nh\u01B0ng
                \u0111\xE3 mu\u1ED9n."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "M\u1ED9t b\xF3ng ng\u01B0\u1EDDi l\u1EADp t\u1EE9c ch\u1EAFn
                tr\u01B0\u1EDBc m\u1EB7t.\nLunen lao t\u1EDBi."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: Keng!
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "L\u01B0\u1EE1i gi\xE1o b\u1ECB ch\u1EB7n l\u1EA1i ngay tr\u01B0\u1EDBc
                ng\u1EF1c thi\u1EBFu ni\xEAn. Lunen nghi\xEAng v\u0169 kh\xED, \u0111\xE1nh
                b\u1EADt n\xF3 sang m\u1ED9t b\xEAn r\u1ED3i xoay ng\u01B0\u1EDDi
                h\u1EA1 g\u1EE5c con ma v\u1EADt ch\u1EC9 trong m\u1ED9t \u0111\xF2n.\nThi\u1EBFu
                ni\xEAn \u0111\u1EE9ng ph\xEDa sau c\u1EADu, \xE1nh m\u1EAFt tho\xE1ng
                hi\u1EC7n l\xEAn v\u1EBB kinh ng\u1EA1c."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
