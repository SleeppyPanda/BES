        - speaker: 
          text: "Lunen d\u1EA7n hi\u1EC3u r\u1EB1ng v\u1EBB huy ho\xE0ng c\u1EE7a
            Akherat ch\u1EC9 l\xE0 m\u1ED9t ph\u1EA7n c\u1EE7a v\u01B0\u01A1ng qu\u1ED1c.\n\u0110\u1EB1ng
            sau nh\u1EEFng b\u1EE9c t\u01B0\u1EDDng v\xE0ng l\xE0 m\u1ED9t v\xF9ng
            \u0111\u1EA5t \u0111ang ph\u1EA3i ch\u1ED1ng ch\u1ECDi v\u1EDBi h\u1EA1n
            h\xE1n.\nM\u1ED9t tri\u1EC1u \u0111\xECnh t\u1ED3n t\u1EA1i nh\u1EEFng
            b\u1EA5t \u0111\u1ED3ng v\u1EC1 ng\u01B0\u1EDDi k\u1EBF th\u1EEBa.\nM\u1ED9t
            n\u1EEF ph\xF9 th\u1EE7y b\u1ECB l\u01B0u \u0111\xE0y v\u1EABn \u0111ang
            \u1EA9n m\xECnh \u0111\xE2u \u0111\xF3 trong khu r\u1EEBng."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "V\xE0 nh\u1EEFng v\u1EE5 m\u1EA5t t\xEDch ch\u01B0a c\xF3 l\u1EDDi
            gi\u1EA3i.\nM\u1ED9t bu\u1ED5i chi\u1EC1u, c\u1EA3 nh\xF3m tr\u1EDF l\u1EA1i
            qu\u1EA3ng tr\u01B0\u1EDDng ch\xEDnh.\nM\u1ED9t \u0111\xE0i t\u1EBF kh\u1ED5ng
            l\u1ED3 \u0111\xE3 g\u1EA7n ho\xE0n thi\u1EC7n. Nh\u1EEFng d\u1EA3i v\u1EA3i
            xanh tr\u1EA3i d\xE0i t\u1EEB \u0111\u1EC9nh c\u1ED9t xu\u1ED1ng m\u1EB7t
            \u0111\u1EA5t, xen gi\u1EEFa c\xE1c bi\u1EC3u t\u01B0\u1EE3ng c\u1EE7a
            m\u1EB7t tr\u1EDDi v\xE0 ng\u1ECDn l\u1EEDa."
