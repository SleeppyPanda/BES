          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "Khai ti\u1EC7c."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Kh\xF4ng kh\xED b\u1EEFa ti\u1EC7c d\u1EA7n tr\u1EDF l\u1EA1i b\xECnh
            th\u01B0\u1EDDng. Lunen v\xE0 Tinh Linh \u0111\u01B0\u1EE3c s\u1EAFp
            x\u1EBFp ng\u1ED3i g\u1EA7n khu v\u1EF1c c\u1EE7a Elio.\nTrong l\xFAc
            b\u1EEFa ti\u1EC7c di\u1EC5n ra, Aurelian ch\u1EE7 \u0111\u1ED9ng h\u1ECFi
            Lunen v\u1EC1 h\xE0nh tr\xECnh c\u1EE7a c\u1EADu."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
