          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "Ta ghi nh\u1EADn."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "Nh\u01B0ng nh\u1EAFc nh\u1EDF ng\u01B0\u1EDDi k\u1EBF th\u1EEBa
            v\xE0 l\xE0m m\u1EA5t th\u1EC3 di\u1EC7n c\u1EE7a ho\xE0ng gia tr\u01B0\u1EDBc
            kh\xE1ch l\xE0 hai chuy\u1EC7n kh\xE1c nhau."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
