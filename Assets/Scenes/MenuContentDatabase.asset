          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Lunen
          text: "Th\u1EADt s\u1EF1 r\u1EA5t \u0111\xF4ng ng\u01B0\u1EDDi t\u1EDBi
            \u0111\u1EC3 xem l\u1EC5 n\xE0y !"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 0
