        - speaker: 
          text: "\u0110i\u1EC1u khi\u1EBFn Lunen v\xE0 tinh linh th\u1EADt s\u1EF1
            cho\xE1ng ng\u1EE3p ch\u1EC9 xu\u1EA5t hi\u1EC7n khi h\u1ECD \u0111\u1EB7t
            ch\xE2n t\u1EDBi qu\u1EA3ng tr\u01B0\u1EDDng tr\u01B0\u1EDBc ho\xE0ng
            cung."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
