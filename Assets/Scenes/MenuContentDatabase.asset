              m_Calls: []
        - speaker: Tinh Linh
          text: "L\u1EA1i n\u1EEFa?! Ng\u01B0\u1EDDi Akherat c\xE1c c\u1EADu \u0111\u1EC1u
            th\xEDch ch\u0129a ki\u1EBFm v\xE0o kh\xE1ch tr\u01B0\u1EDBc khi n\xF3i
            chuy\u1EC7n \xE0?!"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
