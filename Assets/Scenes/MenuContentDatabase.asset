            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Elio kh\xF4ng \u0111\xE1p l\u1EA1i.\nC\u1EADu ch\u1EC9 nh\xECn nh\u1EEFng
            ng\u01B0\u1EDDi tr\u01B0\u1EDBc m\u1EB7t, s\u1EAFc m\u1EB7t l\u1EA1nh
            h\u1EB3n xu\u1ED1ng. B\xE0n tay \u0111\u1EB7t b\xEAn ng\u01B0\u1EDDi
            si\u1EBFt nh\u1EB9, nh\u01B0ng v\u1EABn gi\u1EEF im l\u1EB7ng.\nAurelian
            l\xEAn ti\u1EBFng."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "\u0110\u1EE7 r\u1ED3i. B\xE0n t\xE1n l\u01B0\u1EDDi ong ti\u1EBFng
            b\u01B0\u1EDBm ngay tr\u01B0\u1EDBc m\u1EB7t \xE1nh d\u01B0\u01A1ng c\u1EE7a
            v\u01B0\u01A1ng tri\u1EC1u , c\xE1c ng\u01B0\u01A1i c\xF3 m\u1EA5y c\xE1i
            \u0111\u1EA7u \u0111\u1EC3 ch\u1ECBu tr\xE1ch nhi\u1EC7m!"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Ch\u1EC9 v\xE0i c\xE2u n\xF3i . \u0110\u1EA1i \u0111i\u1EC7n l\u1EADp
            t\u1EE9c im ph\u0103ng ph\u1EAFc."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "C\xE1c ng\u01B0\u01A1i \u0111ang \u0111\u1EE9ng tr\u01B0\u1EDBc
            kh\xE1ch c\u1EE7a Akherat."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
