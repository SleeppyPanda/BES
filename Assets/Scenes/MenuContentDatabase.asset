              m_Calls: []
        - speaker: Sahure
          text: "Ta ch\u1EC9 kh\xF4ng th\xEDch m\u1ED9t tri\u1EC1u \u0111\xECnh \u0111ang
            \u0111\u1EE9ng tr\u01B0\u1EDBc h\u1EA1n h\xE1n, ma v\u1EADt v\xE0 m\u1ED9t
            cu\u1ED9c t\u1EADp k\xEDch ch\u01B0a r\xF5 th\u1EE7 ph\u1EA1m l\u1EA1i
            d\xE0nh c\u1EA3 bu\u1ED5i s\xE1ng \u0111\u1EC3 tranh lu\u1EADn nh\u1EEFng
            chuy\u1EC7n \u0111\xE3 \u0111\u01B0\u1EE3c quy\u1EBFt \u0111\u1ECBnh
            t\u1EEB nhi\u1EC1u n\u0103m tr\u01B0\u1EDBc."
