              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Elio
              text: "N\u1EBFu tuy\u1EBFn ph\xEDa Nam v\u1EE1, h\xE0ng tr\u0103m ng\u01B0\u1EDDi
                s\u1EBD ch\u1EBFt."
