          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "Hai ng\u01B0\u1EDDi d\u1EADy ch\u01B0a?"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Tinh Linh
          text: "Gi\u1ECDng n\xE0y nghe quen qu\xE1..."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Lunen m\u1EDF c\u1EEDa. Rashad \u0111ang \u0111\u1EE9ng b\xEAn ngo\xE0i,
            l\u1EA7n n\xE0y kh\xF4ng m\u1EB7c l\u1EC5 ph\u1EE5c nh\u01B0 t\u1ED1i
            qua m\xE0 \u0111\xE3 tr\u1EDF l\u1EA1i b\u1ED9 trang ph\u1EE5c h\u1ED9
            v\u1EC7 th\u01B0\u1EDDng ng\xE0y."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "B\u1EC7 h\u1EA1 \u0111\xE3 cho ph\xE9p hai ng\u01B0\u1EDDi t\u1EDBi
            \u0110\u1EA1i Th\u01B0 Kh\u1ED1. \u0110i\u1EC7n h\u1EA1 b\u1EA3o ta \u0111\u01B0a
            hai ng\u01B0\u1EDDi qua \u0111\xF3."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Tinh Linh
          text: "H\xF4m nay kh\xF4ng c\xF3 m\xE0n r\xFAt ki\u1EBFm h\u1ECFi cung
            n\u1EEFa ch\u1EE9?"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "N\u1EBFu hai ng\u01B0\u1EDDi kh\xF4ng l\xE0m g\xEC \u0111\xE1ng
            nghi."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Tinh Linh
          text: "...V\u1EADy v\u1EABn c\xF3 kh\u1EA3 n\u0103ng \xE0?"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "Ta \u0111\xF9a th\xF4i."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Tinh Linh
          text: "C\u1EADu n\xF3i b\u1EB1ng c\xE1i m\u1EB7t \u0111\xF3 th\xEC ai bi\u1EBFt
            \u0111\u01B0\u1EE3c!"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Rashad kh\u1EBD b\u1EADt c\u01B0\u1EDDi r\u1ED3i ra hi\u1EC7u cho
            hai ng\u01B0\u1EDDi \u0111i theo.\n\u0110\u1EA1i Th\u01B0 Kh\u1ED1 n\u1EB1m
            \u1EDF m\u1ED9t khu t\u01B0\u01A1ng \u0111\u1ED1i y\xEAn t\u0129nh c\u1EE7a
            ho\xE0ng cung. C\xE0ng ti\u1EBFn s\xE2u v\xE0o b\xEAn trong, ti\u1EBFng
            ng\u01B0\u1EDDi c\xE0ng \xEDt \u0111i, thay v\xE0o \u0111\xF3 ch\u1EC9
            c\xF2n ti\u1EBFng b\u01B0\u1EDBc ch\xE2n v\u1ECDng l\u1EA1i gi\u1EEFa
            nh\u1EEFng h\xE0nh lang \u0111\xE1."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Khi c\xE1nh c\u1EEDa l\u1EDBn m\u1EDF ra, Tinh Linh l\u1EADp t\u1EE9c
            \u0111\u1EE9ng s\u1EEFng.\nTr\u01B0\u1EDBc m\u1EAFt h\u1ECD l\xE0 h\xE0ng
            tr\u0103m gi\xE1 s\xE1ch cao n\u1ED1i ti\u1EBFp nhau, xen l\u1EABn v\xF4
            s\u1ED1 t\u1EE7 l\u01B0u tr\u1EEF, bia \u0111\xE1, cu\u1ED9n v\u0103n
            th\u01B0 v\xE0 nh\u1EEFng c\u1EA7u thang nh\u1ECF d\u1EABn t\u1EDBi c\xE1c
            t\u1EA7ng ph\xEDa tr\xEAn."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Tinh Linh
          text: "...Ch\xFAng ta ph\u1EA3i t\xECm trong t\u1EA5t c\u1EA3 ch\u1ED7
            n\xE0y sao?"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
