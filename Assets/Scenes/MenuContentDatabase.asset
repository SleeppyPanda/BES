              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Elio c\u1ED1.\nNh\u01B0ng c\xE1nh tay kh\xF4ng nghe l\u1EDDi.\nNephkar
                gi\u01A1 tay.\nNh\u1EEFng \u0111\u01B0\u1EDDng ma thu\u1EADt \u0111en
                b\u1EAFt \u0111\u1EA7u qu\u1EA5n quanh c\u01A1 th\u1EC3 Elio."
