              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Sahure
              text: "Akherat m\u1EDBi th\u1EF1c s\u1EF1 g\u1EB7p r\u1EAFc r\u1ED1i."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
