              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Khepraen nghi\u1EBFn r\u0103ng."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
