            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "M\u1ED9t l\xFAc sau, h\u1ECD cu\u1ED1i c\xF9ng c\u0169ng \u0111\u1EBFn
            khu d\xE0nh cho kh\xE1ch. Rashad m\u1EDF c\xE1nh c\u1EEDa l\u1EDBn, \u0111\u1EC3
            l\u1ED9 m\u1ED9t c\u0103n ph\xF2ng r\u1ED9ng nh\xECn ra nh\u1EEFng m\xE1i
            v\xF2m c\u1EE7a Ho\xE0ng th\xE0nh."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
