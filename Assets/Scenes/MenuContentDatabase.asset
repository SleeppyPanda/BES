          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Kh\xF3e m\xF4i Aurelian h\u01A1i cong l\xEAn, nh\u01B0ng ch\u1EC9
            tho\xE1ng qua.\n\u0110\xFAng l\xFAc \u1EA5y, ti\u1EBFng b\u01B0\u1EDBc
            ch\xE2n vang l\xEAn t\u1EEB ph\xEDa c\u1EEDa \u0111\u1EA1i \u0111i\u1EC7n.\nSahure
            c\xF9ng c\xE1c th\xE0nh vi\xEAn H\u1ED9i \u0111\u1ED3ng T\u01B0 t\u1EBF
            ti\u1EBFn v\xE0o. T\u1EA5t c\u1EA3 \u0111\u1ED3ng lo\u1EA1t h\xE0nh l\u1EC5."
