                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "To\xE0n b\u1ED9 \u0111\xE1m ma v\u1EADt tr\u01B0\u1EDBc m\u1EB7t
                Elio bi\u1EBFn m\u1EA5t trong bi\u1EC3n l\u1EEDa.\nKh\xF4ng c\xF2n
                l\u1EA5y m\u1ED9t ti\u1EBFng g\u1EA7m.\nCh\u1EC9 c\xF2n tro b\u1EE5i
                r\u01A1i xu\u1ED1ng.\nElio s\u1EEFng ng\u01B0\u1EDDi."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
