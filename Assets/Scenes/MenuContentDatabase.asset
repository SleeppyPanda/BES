            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Nh\u1EEFng ng\xE0y ti\u1EBFp theo, Lunen v\xE0 Tinh Linh ti\u1EBFp
            t\u1EE5c \u0111\u1ED3ng h\xE0nh c\xF9ng Elio v\xE0 Rashad trong nhi\u1EC1u
            chuy\u1EBFn th\u1ECB s\xE1t.\nH\u1ECD \u0111i qua nh\u1EEFng khu ch\u1EE3
            \u0111ang chu\u1EA9n b\u1ECB v\u1EADt ph\u1EA9m t\u1EBF l\u1EC5, ki\u1EC3m
            tra nh\u1EEFng gi\u1EBFng n\u01B0\u1EDBc c\u1ED5, t\u1EDBi nh\u1EEFng
            khu v\u1EF1c b\u1ECB \u1EA3nh h\u01B0\u1EDFng n\u1EB7ng nh\u1EA5t b\u1EDFi
            h\u1EA1n h\xE1n v\xE0 ch\u1EE9ng ki\u1EBFn ng\xE0y c\xE0ng nhi\u1EC1u
            \u0111\u1ED9i h\u1ED9 v\u1EC7 \u0111\u01B0\u1EE3c \u0111i\u1EC1u \u0111\u1ED9ng
            v\u1EC1 ph\xEDa khu r\u1EEBng."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
