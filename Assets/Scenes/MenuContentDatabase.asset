                  m_Calls: []
            - speaker: 
              text: "X\u01B0\u1EDFng r\xE8n c\u1EE7a Bekhet n\u1EB1m \u1EDF khu c\u0169
                ph\xEDa T\xE2y Ho\xE0ng th\xE0nh.\nLunen v\u1EEBa b\u01B0\u1EDBc
                v\xE0o \u0111\xE3 c\u1EA3m nh\u1EADn \u0111\u01B0\u1EE3c s\u1EE9c
                n\xF3ng kh\u1EE7ng khi\u1EBFp.\nM\u1ED9t \xF4ng l\xE3o \u0111ang
                \u0111\u1EE9ng tr\u01B0\u1EDBc l\xF2 r\xE8n, kh\xF4ng th\xE8m quay
                \u0111\u1EA7u."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
