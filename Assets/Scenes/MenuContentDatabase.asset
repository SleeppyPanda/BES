              m_Calls: []
        - speaker: Rashad
          text: "M\u1EB7t tr\u1EDDi v\u0129 \u0111\u1EA1i - Aurelian - H\u1ECFa th\u1EA7n
            \u0111\u01B0\u01A1ng nhi\u1EC7m c\u1EE7a Akherat. \u0110\u1ED3ng th\u1EDDi
            c\u0169ng l\xE0 ng\u01B0\u1EDDi hi\u1EC7n t\u1EA1i \u0111ang \u0111i\u1EC1u
            h\xE0nh v\u01B0\u01A1ng qu\u1ED1c."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
