          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Thi\u1EBFu ni\xEAn kh\xF4ng tr\u1EA3 l\u1EDDi ngay. C\u1EADu ch\u1EC9
            nh\xECn hai ng\u01B0\u1EDDi tr\u01B0\u1EDBc m\u1EB7t, \xE1nh m\u1EAFt
            v\u1EABn gi\u1EEF nguy\xEAn s\u1EF1 c\u1EA3nh gi\xE1c.\n\u0110\xFAng
            l\xFAc \u0111\xF3, tinh linh \u0111\u1ED9t nhi\xEAn nh\xECn th\u1EA5y
            m\u1ED9t chuy\u1EC3n \u0111\u1ED9ng \u1EDF ph\xEDa sau c\u1EADu."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
