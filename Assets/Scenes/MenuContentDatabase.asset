              m_Calls: []
        - speaker: Tinh Linh
          text: "V\u1EADy n\xEAn v\u1ECB h\u1ECFa th\u1EA7n n\xE0y  c\u0169ng s\u1ED1ng
            trong cung \u0111i\u1EC7n nh\u01B0 m\u1ED9t ng\u01B0\u1EDDi b\xECnh th\u01B0\u1EDDng?"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
