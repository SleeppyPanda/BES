              m_Calls: []
        - speaker: 
          text: "\xC1nh m\u1EAFt b\xE0 d\u1EEBng tr\xEAn nh\u1EEFng k\xFD t\u1EF1
            \u0111\u01B0\u1EE3c kh\u1EAFc quanh m\u1EB7t v\xF2ng."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
