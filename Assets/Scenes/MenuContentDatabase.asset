          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Elio d\u1EABn hai ng\u01B0\u1EDDi ti\u1EBFn v\xE0o \u0111\u1EA1i
            \u0111i\u1EC7n.\n\u1EDE cu\u1ED1i \u0111\u1EA1i \u0111i\u1EC7n, tr\u01B0\u1EDBc
            ngai v\xE0ng, Aurelian \u0111ang \u0111\u1EE9ng gi\u1EEFa \xE1nh s\xE1ng
            c\u1EE7a nh\u1EEFng \u0111\xE0i l\u1EEDa.\nCh\u1EC9 trong kho\u1EA3nh
            kh\u1EAFc \u0111\u1EA7u ti\xEAn nh\xECn th\u1EA5y b\xE0, Lunen \u0111\xE3
            hi\u1EC3u l\u1EDDi Rashad."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Aurelian kh\xF4ng c\u1EA7n ph\xF4 b\xE0y s\u1EE9c m\u1EA1nh. S\u1EF1
            hi\u1EC7n di\u1EC7n c\u1EE7a b\xE0 t\u1EF1 n\xF3 \u0111\xE3 t\u1EA1o
            ra m\u1ED9t \xE1p l\u1EF1c r\u1EA5t kh\xF3 di\u1EC5n t\u1EA3. \xC1nh
            m\u1EAFt b\xECnh t\u0129nh, d\xE1ng \u0111\u1EE9ng ki\xEAu h\xE3nh v\xE0
            kh\xED ch\u1EA5t c\u1EE7a ng\u01B0\u1EDDi \u0111\xE3 qu\xE1 quen v\u1EDBi
            vi\u1EC7c \u0111\u01B0a ra nh\u1EEFng quy\u1EBFt \u0111\u1ECBnh kh\xF4ng
            ai c\xF3 quy\u1EC1n ch\u1EA5t v\u1EA5n khi\u1EBFn Lunen v\xF4 th\u1EE9c
            nghi\xEAm t\xFAc h\u01A1n.\nElio b\u01B0\u1EDBc t\u1EDBi tr\u01B0\u1EDBc."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
