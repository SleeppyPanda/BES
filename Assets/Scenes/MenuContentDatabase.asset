          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Rashad ng\u1EA9ng \u0111\u1EA7u nh\xECn b\u1EE9c ph\xF9 \u0111i\xEAu."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "\xC1nh th\xE1i d\u01B0\u01A1ng ng\xE0y c\xE0ng tr\u1EDF n\xEAn kh\u1EAFc
            nghi\u1EC7t. N\u01B0\u1EDBc c\u1EA1n, c\xE2y c\u1ED1i ch\u1EBFt \u0111i,
            \u0111\u1EA5t \u0111ai kh\xF4ng th\u1EC3 sinh tr\u01B0\u1EDFng. Ng\u01B0\u1EDDi
            d\xE2n s\u1ED1ng quanh \u0111\xE2y d\u1EA7n ch\u1EBFt v\xEC \u0111\xF3i
            v\xE0 n\xF3ng."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "V\xE0 ng\u01B0\u1EDDi \u0111\xE3 quy\u1EBFt \u0111\u1ECBnh l\xE0m
            m\u1ED9t chuy\u1EC7n m\xE0 kh\xF4ng ai tr\u01B0\u1EDBc \u0111\xF3 d\xE1m
            ngh\u0129 t\u1EDBi."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
