        - id: chapter_1_scene_1_phase_2_trigger_4
          triggerType: 8
          round: 1
          healthPercent: 50
          enemyCount: 0
          unitId: 
          pauseCombat: 1
          actionAfterDialogue: 5
          convertUnitId: 
          dialogue:
            id: chapter_1_scene_1_phase_2_trigger_4_dialogue
            title: "Combat - khi th\u1EAFng tr\u1EADn"
            summary: "kh\xF4ng c\u1EA7n hi\u1EC3n th\u1ECB win/lose panel. quay tr\u1EDF
              v\u1EC1 story panel v\xE0 ti\u1EBFp t\u1EE5c tuy\u1EBFn truy\u1EC7n"
            beats:
            - speaker: 
              text: "Tr\u1EADn chi\u1EBFn cu\u1ED1i c\xF9ng di\u1EC5n ra r\u1EA5t
                nhanh.\nKh\xF4ng c\xF2n l\u1EE3i th\u1EBF t\u1EEB nh\u1EEFng con
                tin hay s\u1EF1 ph\xE2n t\xE1n c\u1EE7a qu\xE2n \u0111\u1ED9i, Nephkar
                ho\xE0n to\xE0n kh\xF4ng th\u1EC3 ch\u1ED1ng l\u1EA1i Aurelian."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Lunen ph\xE1 k\u1EBFt gi\u1EDBi.\nElio c\u1EAFt \u0111\u1EE9t
                \u0111\u01B0\u1EDDng lui.\nRashad ch\u1EB7n \u0111\xE1m ma v\u1EADt
                b\u1EA3o v\u1EC7 ch\u1EE7 nh\xE2n.\nRamesses gi\u1EEF v\u1EEFng \u0111\u1ED9i
                h\xECnh.\nKasim tr\u1EF1c ti\u1EBFp x\u1EED l\xFD nh\u1EEFng m\u1EE5c
                ti\xEAu nguy hi\u1EC3m nh\u1EA5t."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Cu\u1ED1i c\xF9ng, Aurelian tung m\u1ED9t \u0111\xF2n xuy\xEAn
                th\u1EB3ng qua ma thu\u1EADt b\u1EA3o h\u1ED9 c\u1EE7a Nephkar.\nNephkar
                ng\xE3 xu\u1ED1ng."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Nephkar
              text: "Kh\xF4ng..."
