          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Sahure
          text: "\u0110i\u1EC7n h\u1EA1 v\u1EABn lu\xF4n... r\u1ED9ng l\u01B0\u1EE3ng
            trong chuy\u1EC7n k\u1EBFt giao."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
