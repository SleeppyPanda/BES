      - speaker: Tinh Linh
        text: "Khoan \u0111\xE3\u2014?! C\u1EADu ta kh\xF4ng \u0111\u1ECBnh h\u1ECFi
          g\xEC lu\xF4n \xE0?!"
        background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
