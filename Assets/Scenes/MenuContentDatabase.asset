    stages:
    - id: chapter_1_stage_1
      title: "R\u1EEBng bi\xEAn gi\u1EDBi Akherat"
      description: "Lunen v\xE0 Elio t\u1EEB hi\u1EC3u l\u1EA7m ban \u0111\u1EA7u
        bu\u1ED9c ph\u1EA3i c\xF9ng chi\u1EBFn \u0111\u1EA5u khi ma v\u1EADt xu\u1EA5t
        hi\u1EC7n."
      preview: {fileID: 21300000, guid: dd1c02f6776dbd04db6a75e2fc2d0ba9, type: 3}
      energyCost: 10
      preBattleDialogue:
        id: chapter_1_stage_1_story
        title: "R\u1EEBng bi\xEAn gi\u1EDBi Akherat"
        summary: "Lunen v\xE0 Elio t\u1EEB hi\u1EC3u l\u1EA7m ban \u0111\u1EA7u bu\u1ED9c
          ph\u1EA3i c\xF9ng chi\u1EBFn \u0111\u1EA5u khi ma v\u1EADt xu\u1EA5t hi\u1EC7n."
        beats:
        - speaker: "Ch\u01B0\u01A1ng 1"
          text: "Quest: Ng\u1ECDn L\u1EEDa D\u01B0\u1EDBi M\u1EB7t Tr\u1EDDi Sa M\u1EA1c"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
