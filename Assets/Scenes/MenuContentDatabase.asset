          dialogue:
            id: chapter_1_scene_1_phase_2_trigger_1_dialogue
            title: "Combat - khi c\xF3 2 con qu\xE1i con ch\u1EBFt d\xF9ng b\u1ED9
              \u0111\u1EBFm \u1EA9n \u0111\u1EC3 \u0111\u1EBFm s\u1ED1 qu\xE1i \u0111\u01B0\u1EE3c
              tri\u1EC7u h\u1ED3i \u0111\xE3 ti\xEAu di\u1EC7t."
            summary: "1 \xE1nh s\xE1ng \u0111en t\u1EEB boss t\u1EA5n c\xF4ng v\xE0o
              nh\xE2n v\u1EADt Elio k\xE9o xu\u1ED1ng c\xF2n 10% hp. th\u1EF1c hi\u1EC7n
              trigger ti\u1EBFp theo ngay l\u1EADp t\u1EE9c."
            beats:
            - speaker: 
              text: "Tr\u1EADn chi\u1EBFn nhanh ch\xF3ng lan kh\u1ECFi T\u1EBF \u0111i\u1EC7n.\nNephkar
                kh\xF4ng tr\u1EF1c ti\u1EBFp giao chi\u1EBFn l\xE2u.\nB\xE0 ta li\xEAn
                t\u1EE5c tri\u1EC7u h\u1ED3i ma v\u1EADt r\u1ED3i r\xFAt s\xE2u v\u1EC1
                ph\xEDa khu d\xE2n c\u01B0, bu\u1ED9c Elio ph\u1EA3i \u0111u\u1ED5i
                theo."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Lunen
              text: "B\xE0 ta \u0111ang d\u1EABn ch\xFAng ta \u0111i."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
