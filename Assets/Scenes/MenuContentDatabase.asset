            - speaker: 
              text: "M\u1ED9t ma v\u1EADt lao t\u1EDBi.\nElio \u0111\u1EE1.\nCon
                th\u1EE9 hai \u0111\xE1nh ngang.\nC\u1EADu tr\xE1nh \u0111\u01B0\u1EE3c."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
