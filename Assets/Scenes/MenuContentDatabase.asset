              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Nh\u1EEFng ti\u1EBFng reo h\xF2 lan kh\u1EAFp qu\u1EA3ng tr\u01B0\u1EDDng.\nC\xF3
                ng\u01B0\u1EDDi qu\u1EF3 xu\u1ED1ng.\nC\xF3 ng\u01B0\u1EDDi b\u1EADt
                kh\xF3c.\nNh\u1EEFng \u0111\u1EE9a tr\u1EBB \u0111\u01B0a tay h\u1EE9ng
                n\u01B0\u1EDBc m\u01B0a."
