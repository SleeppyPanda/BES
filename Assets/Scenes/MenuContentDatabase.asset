          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Sahure
          text: "Th\u1EA7n kh\xF4ng d\xE1m. Ch\xFAng ta c\u0169ng ch\u1EC9 mu\u1ED1n
            t\u1ED1t cho v\u01B0\u01A1ng t\u1EED th\xF4i"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
