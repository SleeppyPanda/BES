          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Lunen
          text: "\xD4ng \u1EA5y kh\xF4ng mu\u1ED1n r\xE8n v\u0169 kh\xED cho m\u1ED9t
            ng\u01B0\u1EDDi \u0111ang c\u1ED1 tr\u1EDF th\xE0nh Aurelian."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
