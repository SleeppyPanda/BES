          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "M\u1ED9t v\u1ECB \u0111\u1EA1i th\u1EA7n ng\u1ED3i g\u1EA7n \u0111\xF3
            l\xEAn ti\u1EBFng."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
