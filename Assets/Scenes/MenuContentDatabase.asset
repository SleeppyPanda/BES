            m_PersistentCalls:
              m_Calls: []
        - speaker: Sahure
          text: "Nh\u01B0ng chuy\u1EC7n \u0110i\u1EC7n h\u1EA1 kh\xF4ng mang th\u1EA7n
            huy\u1EBFt c\u0169ng kh\xF4ng ph\u1EA3i \u0111i\u1EC1u h\xF4m nay ch\xFAng
            ta m\u1EDBi bi\u1EBFt."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
