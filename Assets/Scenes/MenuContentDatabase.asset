              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Aurelian
              text: "H\xF4m nay, ta l\u1EA5y danh ngh\u0129a H\u1ECFa th\u1EA7n \u0111\u1EDDi
                n\xE0y..."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Aurelian
              text: "C\u1EA7u cho \u0111\u1EA5t tr\u1EDDi tr\u1EDF l\u1EA1i c\xE2n
                b\u1EB1ng."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Ng\u1ECDn l\u1EEDa tr\xEAn T\u1EBF Thi\xEAn \u0110\xE0i b\xF9ng
                l\xEAn.\nM\u1ED9t lu\u1ED3ng n\u0103ng l\u01B0\u1EE3ng m\u1EA1nh
                m\u1EBD lan kh\u1EAFp qu\u1EA3ng tr\u01B0\u1EDDng."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Lunen ng\u1EA9ng \u0111\u1EA7u.\nB\u1EA7u tr\u1EDDi v\u1ED1n
                trong veo b\u1EAFt \u0111\u1EA7u xu\u1EA5t hi\u1EC7n m\xE2y.\nTinh
                Linh tr\xF2n m\u1EAFt."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Tinh Linh
              text: Lunen...
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "M\u1ED9t gi\u1ECDt n\u01B0\u1EDBc r\u01A1i xu\u1ED1ng tay c\xF4.\nR\u1ED3i
                th\xEAm m\u1ED9t gi\u1ECDt n\u1EEFa.\nCh\u1EC9 trong v\xE0i kho\u1EA3nh
                kh\u1EAFc, m\u01B0a b\u1EAFt \u0111\u1EA7u r\u01A1i.\nBan \u0111\u1EA7u
                r\u1EA5t nh\u1EB9."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Sau \u0111\xF3 ng\xE0y c\xE0ng d\xE0y.\nTo\xE0n b\u1ED9 qu\u1EA3ng
                tr\u01B0\u1EDDng im l\u1EB7ng.\nR\u1ED3i m\u1ED9t ti\u1EBFng reo
                vang l\xEAn."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
