          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "N\u1EBFu mu\u1ED1n t\xECm hi\u1EC3u, ng\xE0y mai ng\u01B0\u01A1i
            c\xF3 th\u1EC3 t\u1EDBi \u0110\u1EA1i Th\u01B0 Kh\u1ED1."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
