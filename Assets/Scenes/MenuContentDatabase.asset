          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Ch\u1EC9 trong m\u1ED9t tho\xE1ng r\u1EA5t ng\u1EAFn, kh\xF3e m\xF4i
            Sahure c\u1EE9ng l\u1EA1i.\nBi\u1EC3u c\u1EA3m \u1EA5y bi\u1EBFn m\u1EA5t
            nhanh \u0111\u1EBFn m\u1EE9c n\u1EBFu kh\xF4ng ch\xFA \xFD c\xF3 l\u1EBD
            ch\u1EB3ng ai nh\u1EADn ra."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
