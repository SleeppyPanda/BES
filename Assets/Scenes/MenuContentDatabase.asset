          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Lunen
          text: "Tr\u1ED1n ti\u1EC7c \xE0?"
