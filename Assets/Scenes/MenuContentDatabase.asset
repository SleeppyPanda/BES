          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "Ta h\u1ECFi ng\u01B0\u01A1i l\xE0 ai, t\u1EEB \u0111\xE2u \u0111\u1EBFn,
            v\xE0 m\u1EE5c \u0111\xEDch ti\u1EBFp c\u1EADn \u0110i\u1EC7n h\u1EA1
            l\xE0 g\xEC."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
