          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "S\xE1ng h\xF4m sau, khi Lunen v\xE0 Tinh Linh v\u1EEBa chu\u1EA9n
            b\u1ECB xong, ti\u1EBFng g\xF5 c\u1EEDa \u0111\xE3 vang l\xEAn."
