              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Bekhet
              text: "N\u1EBFu s\u1EEDa ki\u1EBFm, \u0111\u1EB7t b\xEAn tr\xE1i."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
