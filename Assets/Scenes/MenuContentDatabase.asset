    - id: chapter_1_stage_5
      title: "\u0110\u1EA1i l\u1EC5 t\u1EBF tr\u1EDDi"
      description: "\u0110\u1EA1i l\u1EC5 t\u1EBF tr\u1EDDi b\u1ECB ma v\u1EADt t\u1EADp
        k\xEDch, Aurelian ra tay c\u1EE9u Elio r\u1ED3i nghi l\u1EC5 chuy\u1EC3n
        th\xE0nh bi\u1EBFn c\u1ED1 nguy hi\u1EC3m."
      preview: {fileID: 0}
      energyCost: 10
      preBattleDialogue:
        id: chapter_1_stage_5_story
        title: "\u0110\u1EA1i l\u1EC5 t\u1EBF tr\u1EDDi"
        summary: "\u0110\u1EA1i l\u1EC5 t\u1EBF tr\u1EDDi b\u1ECB ma v\u1EADt t\u1EADp
          k\xEDch, Aurelian ra tay c\u1EE9u Elio r\u1ED3i nghi l\u1EC5 chuy\u1EC3n
          th\xE0nh bi\u1EBFn c\u1ED1 nguy hi\u1EC3m."
        beats:
        - speaker: "C\u1EA3nh 5"
          text: "\u0110\u1EA1i l\u1EC5 t\u1EBF tr\u1EDDi"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "T\u1EEB s\xE1ng s\u1EDBm, to\xE0n b\u1ED9 Ho\xE0ng th\xE0nh Akherat
            \u0111\xE3 ch\xECm trong ti\u1EBFng chu\xF4ng l\u1EC5.\nNh\u1EEFng d\u1EA3i
            l\u1EE5a xanh \u0111\u01B0\u1EE3c treo d\u1ECDc c\xE1c con \u0111\u01B0\u1EDDng
            l\u1EDBn, xen gi\u1EEFa bi\u1EC3u t\u01B0\u1EE3ng m\u1EB7t tr\u1EDDi
            v\xE0 nh\u1EEFng \u0111\xE0i n\u01B0\u1EDBc b\u1EB1ng \u0111\xE1. Ng\u01B0\u1EDDi
            d\xE2n t\u1EEB kh\u1EAFp c\xE1c khu v\u1EF1c \u0111\u1ED5 v\u1EC1 qu\u1EA3ng
            tr\u01B0\u1EDDng trung t\xE2m, n\u01A1i T\u1EBF Thi\xEAn \u0110\xE0i
            kh\u1ED5ng l\u1ED3 \u0111\xE3 \u0111\u01B0\u1EE3c d\u1EF1ng ho\xE0n ch\u1EC9nh."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "\u1EDE ch\xEDnh gi\u1EEFa qu\u1EA3ng tr\u01B0\u1EDDng l\xE0 m\u1ED9t
            \u0111\xE0i t\u1EBF cao b\u1EB1ng \u0111\xE1 tr\u1EAFng. Nh\u1EEFng \u0111\u01B0\u1EDDng
            kh\u1EAFc h\xECnh h\u1ECFa di\u1EC5m ch\u1EA1y d\u1ECDc m\u1EB7t \u0111\xE1,
            h\u1ED9i t\u1EE5 t\u1EA1i bi\u1EC3u t\u01B0\u1EE3ng m\u1EB7t tr\u1EDDi
            \u1EDF trung t\xE2m.\nLunen v\xE0 Tinh Linh \u0111\u01B0\u1EE3c Rashad
            d\u1EABn t\u1EDBi khu v\u1EF1c d\xE0nh cho kh\xE1ch ho\xE0ng gia."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Tinh Linh
          text: "\u0110\xF4ng th\u1EADt \u0111\u1EA5y..."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
