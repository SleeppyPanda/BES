          unitId: 
          pauseCombat: 1
          actionAfterDialogue: 4
          convertUnitId: 
          dialogue:
            id: chapter_1_scene_1_phase_1_trigger_1_dialogue
            title: "Combat - khi tr\u1EADn \u0111\u1EA5u k\u1EBFt th\xFAc kh\xF4ng
              hi\u1EC7n win/lose m\xE0 th\u1EF1c hi\u1EC7n l\u1EC7nh [ck] \u1EDF
              d\xF2ng ti\u1EBFp theo r\u1ED3i ti\u1EBFp t\u1EE5c tuy\u1EBFn truy\u1EC7n"
            summary: "kh\xF4ng hi\u1EC7n win/lose panel. quay tr\u1EDF v\u1EC1 story
              panel v\xE0 ti\u1EBFp t\u1EE5c tuy\u1EBFn truy\u1EC7n"
            beats:
            - speaker: 
              text: "Sau v\xE0i l\u1EA7n chi\u1EBFn \u0111\u1EA5u c\xF9ng nhau, Kasim
                d\u1EA7n kh\xF4ng c\xF2n c\u1ED1 t\xECnh th\u1EED Lunen n\u1EEFa.\nKhi
                tr\u1EADn cu\u1ED1i k\u1EBFt th\xFAc, c\u1EADu lau m\xE1u tr\xEAn
                l\u01B0\u1EE1i ki\u1EBFm."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Kasim
              text: "Kh\xF4ng t\u1EC7."
