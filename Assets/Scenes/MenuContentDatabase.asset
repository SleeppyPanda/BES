                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Nh\u01B0ng ngay sau \u0111\xF3, m\u1ED9t \u0111\xF2n m\u1EA1nh
                t\u1EEB ph\xEDa sau \u0111\xE1nh b\u1EADt v\u0169 kh\xED kh\u1ECFi
                tay c\u1EADu.\nThanh ki\u1EBFm r\u01A1i xu\u1ED1ng n\u1EC1n \u0111\xE1.\nElio
                kh\u1EF1ng l\u1EA1i.\nM\u1ED9t ma v\u1EADt kh\xE1c lao t\u1EDBi."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
