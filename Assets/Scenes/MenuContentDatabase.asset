            - speaker: 
              text: "Nh\u1EEFng ng\xE0y ti\u1EBFp theo, t\xECnh h\xECnh trong tri\u1EC1u
                \u0111\xECnh kh\xF4ng kh\xE1 h\u01A1n.\nAurelian v\u1EABn b\u1EA5t
                t\u1EC9nh.\nH\u1EA1n h\xE1n tuy t\u1EA1m th\u1EDDi \u0111\u01B0\u1EE3c
                gi\u1EA3i t\u1ECFa b\u1EDFi c\u01A1n m\u01B0a sau nghi l\u1EC5, nh\u01B0ng
                nh\u1EEFng m\u1EA1ch n\u01B0\u1EDBc ng\u1EA7m v\u1EABn ch\u01B0a
                ho\xE0n to\xE0n \u1ED5n \u0111\u1ECBnh."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "C\xE1c v\u1EE5 ma v\u1EADt ti\u1EBFp t\u1EE5c xu\u1EA5t hi\u1EC7n.\nCu\u1ED9c
                \u0111i\u1EC1u tra l\u1EDDi nguy\u1EC1n kh\xF4ng c\xF3 ti\u1EBFn
                tri\u1EC3n r\xF5 r\xE0ng.\nV\xE0 H\u1ED9i \u0111\u1ED3ng v\u1EABn
                li\xEAn t\u1EE5c \u0111\u1EB7t c\xE2u h\u1ECFi v\u1EC1 m\u1ECDi quy\u1EBFt
                \u0111\u1ECBnh c\u1EE7a Elio."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: "T\u01B0 t\u1EBF 2"
              text: "\u0110i\u1EC7n h\u1EA1 mu\u1ED1n \u0111i\u1EC1u th\xEAm binh
                l\u1EF1c t\u1EDBi ph\xEDa B\u1EAFc?"
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Elio
              text: "\u0110\xFAng."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: "T\u01B0 t\u1EBF 2"
              text: "Trong khi bi\xEAn gi\u1EDBi ph\xEDa T\xE2y c\u0169ng \u0111ang
                thi\u1EBFu ng\u01B0\u1EDDi?"
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Elio
              text: "Ramesses \u0111\xE3 ph\xE2n t\xEDch s\u1ED1 l\u01B0\u1EE3ng.
                Ch\xFAng ta v\u1EABn \u0111\u1EE7 kh\u1EA3 n\u0103ng gi\u1EEF c\u1EA3
                hai."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: "T\u01B0 t\u1EBF 1"
              text: "Ng\u01B0\u1EDDi \u0111ang \u0111\u1EB7t qu\xE1 nhi\u1EC1u ni\u1EC1m
                tin v\xE0o \u0110\u1ED9i H\u1ED9 v\u1EC7."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Elio
              text: "\u0110\xF3 l\xE0 nh\u1EEFng ng\u01B0\u1EDDi c\xF3 kinh nghi\u1EC7m
                th\u1EF1c chi\u1EBFn."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: "T\u01B0 t\u1EBF 2"
              text: "Nh\u01B0ng quy\u1EBFt \u0111\u1ECBnh cu\u1ED1i c\xF9ng v\u1EABn
                thu\u1ED9c v\u1EC1 ng\u01B0\u1EDDi cai tr\u1ECB."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: "T\u01B0 t\u1EBF 2"
              text: "B\u1EC7 h\u1EA1 Aurelian s\u1EBD kh\xF4ng c\u1EA7n ng\u01B0\u1EDDi
                kh\xE1c quy\u1EBFt \u0111\u1ECBnh thay m\xECnh."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Elio kh\u1EF1ng l\u1EA1i.\nSahure nh\xECn ng\u01B0\u1EDDi v\u1EEBa
                n\xF3i."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Sahure
              text: "V\u1EADy r\u1EA5t may cho ch\xFAng ta l\xE0 \u0110i\u1EC7n h\u1EA1
                kh\xF4ng ph\u1EA3i B\u1EC7 h\u1EA1 Aurelian."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Elio nh\xECn \xF4ng."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
