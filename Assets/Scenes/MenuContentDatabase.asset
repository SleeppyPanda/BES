      victoryDialogue:
        id: chapter_1_stage_6_after
        title: "Sau c\u1EA3nh 6"
        summary: "Aurelian b\u1EA5t t\u1EC9nh, Elio g\xE1nh l\u1EA5y Akherat, r\u1ED3i
          bi\u1EBFn c\u1ED1 Nephkar \u0111\u1EA9y ng\u1ECDn l\u1EEDa k\u1EBF v\u1ECB
          t\u1EDBi th\u1EED th\xE1ch sinh t\u1EED."
        beats:
        - speaker: 
          text: "T\u1ED1i \u0111\xF3, Elio v\u1EABn \u1EDF l\u1EA1i ph\xF2ng ngh\u1ECB
            s\u1EF1.\nLunen b\u01B0\u1EDBc v\xE0o."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Lunen
          text: "C\u1EADu ch\u01B0a ngh\u1EC9 sao?"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 0
