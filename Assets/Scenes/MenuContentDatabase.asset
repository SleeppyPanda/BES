            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Rashad nh\xECn nh\u1EEFng b\u1EE9c ph\xF9 \u0111i\xEAu ch\u1EA1y
            d\u1ECDc theo b\u1EE9c t\u01B0\u1EDDng b\xEAn c\u1EA1nh."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "Chuy\u1EC7n \u0111\xF3 b\u1EAFt \u0111\u1EA7u t\u1EEB v\u1ECB H\u1ECFa
            th\u1EA7n \u0111\u1EA7u ti\xEAn."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "Ng\xE0y \u1EA5y, khi Akherat v\u1EABn ch\u01B0a t\u1ED3n t\u1EA1i,
            ng\u01B0\u1EDDi ta k\u1EC3 r\u1EB1ng t\u1EEB ng\u1ECDn l\u1EEDa nguy\xEAn
            th\u1EE7y tinh khi\u1EBFt nh\u1EA5t \u0111\xE3 sinh ra m\u1ED9t \u0111\u1EE9a
            tr\u1EBB."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "\u0110\u1EE9a tr\u1EBB \u1EA5y l\u1EDBn l\xEAn gi\u1EEFa con ng\u01B0\u1EDDi.
            C\u1EADu h\u1ECDc ng\xF4n ng\u1EEF c\u1EE7a h\u1ECD, chi\u1EBFn \u0111\u1EA5u
            c\xF9ng h\u1ECD v\xE0 ti\u1EBFp thu g\u1EA7n nh\u01B0 m\u1ECDi tri th\u1EE9c
            m\xE0 con ng\u01B0\u1EDDi th\u1EDDi \u0111\xF3 s\u1EDF h\u1EEFu. Khi
            tr\u01B0\u1EDFng th\xE0nh, kh\xF4ng ch\u1EC9 l\xE0 m\u1ED9t chi\u1EBFn
            binh xu\u1EA5t ch\xFAng, c\u1EADu c\xF2n tr\u1EDF th\xE0nh m\u1ED9t trong
            nh\u1EEFng ng\u01B0\u1EDDi th\xF4ng th\xE1i nh\u1EA5t c\u1EE7a v\xF9ng
            \u0111\u1EA5t n\xE0y."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "H\u1ECD ti\u1EBFp t\u1EE5c b\u01B0\u1EDBc qua h\xE0nh lang. \xC1nh
            chi\u1EC1u xuy\xEAn qua nh\u1EEFng \xF4 c\u1EEDa \u0111\xE1, h\u1EAFt
            l\xEAn c\xE1c b\u1EE9c ph\xF9 \u0111i\xEAu h\xECnh m\u1ED9t thi\u1EBFu
            ni\xEAn \u0111ang \u0111\u1EE9ng tr\u01B0\u1EDBc v\u1EA7ng m\u1EB7t tr\u1EDDi
            kh\u1ED5ng l\u1ED3."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
