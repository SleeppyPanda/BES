              m_Calls: []
        - speaker: 
          text: "Elio kh\xF4ng ph\u1EA3n b\xE1c ngay.\nNh\u1EEFng l\u1EDDi Aurelian
            n\xF3i trong ng\xE0y \u0111\u1EA1i l\u1EC5 v\u1EABn c\xF2n qu\xE1 r\xF5
            trong \u0111\u1EA7u c\u1EADu."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
