        - speaker: 
          text: "Ph\xEDa tr\u01B0\u1EDBc kh\xF4ng ch\u1EC9 c\xF3 Elio.\nRashad \u0111\u1EE9ng
            b\xEAn c\u1EA1nh c\u1EADu.\nKhepraen khoanh tay ph\xEDa sau."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
