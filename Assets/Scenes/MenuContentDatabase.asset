              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Sahure
              text: "N\u1EBFu \u0110i\u1EC7n h\u1EA1 c\u1ED1 tr\u1EDF th\xE0nh Ng\u01B0\u1EDDi..."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
