          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Lunen
          text: "R\u1EA5t kh\xF3 gi\u1EA3i th\xEDch."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 0
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Elio
          text: "V\u1EADy th\xEC \xEDt nh\u1EA5t ta kh\xF4ng ph\u1EA3i ng\u01B0\u1EDDi
            duy nh\u1EA5t th\u1EA5y k\u1EF3 l\u1EA1."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Hai ng\u01B0\u1EDDi im l\u1EB7ng m\u1ED9t l\xFAc.\nPh\xEDa d\u01B0\u1EDBi
            qu\u1EA3ng tr\u01B0\u1EDDng, m\u1ED9t \u0111o\xE0n ng\u01B0\u1EDDi \u0111ang
            mang theo nh\u1EEFng d\u1EA3i v\u1EA3i xanh, b\xECnh g\u1ED1m l\u1EDBn,
            hoa kh\xF4 v\xE0 nhi\u1EC1u v\u1EADt trang tr\xED \u0111i ngang qua."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Lunen
          text: "H\u1ECD \u0111ang chu\u1EA9n b\u1ECB g\xEC v\u1EADy?"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 0
          dimRight: 1
