              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Khepraen l\u1EADp t\u1EE9c r\u1EDDi \u0111i."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Lunen b\u1ECB t\xE1ch kh\u1ECFi Elio trong l\xFAc h\u1ED7 tr\u1EE3
                m\u1ED9t nh\xF3m binh s\u0129.\nKhi c\u1EADu cu\u1ED1i c\xF9ng ph\xE1
                \u0111\u01B0\u1EE3c v\xF2ng v\xE2y v\xE0 t\xECm t\u1EDBi n\u01A1i
                \u2014 Elio \u0111\xE3 g\u1EA7n nh\u01B0 kh\xF4ng c\xF2n \u0111\u1EE9ng
                n\u1ED5i.\nRashad c\u0169ng b\u1ECB th\u01B0\u01A1ng, qu\u1EF3 m\u1ED9t
                g\u1ED1i c\xE1ch \u0111\xF3 kh\xF4ng xa.\nNephkar \u0111\u1EE9ng
                tr\u01B0\u1EDBc Elio."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Nephkar
              text: "\u0110\u1EBFn \u0111\xE2y th\xF4i."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
