          m_PersistentCalls:
            m_Calls: []
      - speaker: 
        text: "N\u1EE5 c\u01B0\u1EDDi tr\xEAn khu\xF4n m\u1EB7t thi\u1EBFu ni\xEAn
          l\u1EADp t\u1EE9c bi\u1EBFn m\u1EA5t.\nKh\xF4ng kh\xED xung quanh b\u1ED7ng
          tr\u1EDF n\xEAn n\u1EB7ng n\u1EC1. Nh\u1EEFng b\u1EE5i c\xE2y ph\xEDa xa
          rung l\xEAn d\u1EEF d\u1ED9i, t\u1EEBng \u0111\xE0n chim ho\u1EA3ng lo\u1EA1n
          bay kh\u1ECFi t\xE1n l\xE1. Ch\u1EC9 trong v\xE0i gi\xE2y, h\xE0ng lo\u1EA1t
          b\xF3ng \u0111en b\u1EAFt \u0111\u1EA7u xu\u1EA5t hi\u1EC7n gi\u1EEFa nh\u1EEFng
          th\xE2n c\xE2y."
        background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
        leftCharacter: {fileID: 0}
        rightCharacter: {fileID: 0}
