          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "V\u1EADy l\xE0 ng\u01B0\u1EDDi \u0111ang \u0111i t\xECm b\xED m\u1EADt
            c\u1EE7a chi\u1EBFc v\xF2ng \u0111\xF3?"
