              m_Calls: []
        - speaker: Nefru
          text: "V\u01B0\u01A1ng t\u1EED \u0111i\u1EC7n h\u1EA1 cho m\u1EDDi hai
            v\u1ECB t\u1EDBi \u0111\u1EA1i \u0111i\u1EC7n. Y\u1EBFn ti\u1EC7c s\u1EAFp
            b\u1EAFt \u0111\u1EA7u r\u1ED3i."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
