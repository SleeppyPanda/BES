          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Lunen nh\xECn b\u1EE9c ph\xF9 \u0111i\xEAu."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "Nh\u01B0ng ngay c\u1EA3 khi \u0111\xE3 tr\u1EDF th\xE0nh th\u1EA7n,
            ng\u01B0\u1EDDi ch\u01B0a bao gi\u1EDD r\u1EDDi b\u1ECF nh\u1EEFng con
            ng\u01B0\u1EDDi m\xECnh t\u1EEBng s\u1ED1ng c\xF9ng."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "V\xEC H\u1ECFa th\u1EA7n \u0111\u1EA7u ti\xEAn v\u1ED1n sinh ra
            gi\u1EEFa con ng\u01B0\u1EDDi, n\xEAn nh\u1EEFng v\u1ECB k\u1EBF nhi\u1EC7m
            sau n\xE0y c\u0169ng gi\u1EEF truy\u1EC1n th\u1ED1ng \u0111\xF3. H\u1ECD
            s\u1ED1ng trong Akherat, cai tr\u1ECB, chi\u1EBFn \u0111\u1EA5u v\xE0
            t\u1ED3n t\u1EA1i c\xF9ng con d\xE2n c\u1EE7a m\xECnh."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
