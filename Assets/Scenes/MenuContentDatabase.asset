        - speaker: 
          text: "\xC1nh m\u1EAFt \xF4ng nhanh ch\xF3ng chuy\u1EC3n sang Lunen v\xE0
            tinh linh."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
