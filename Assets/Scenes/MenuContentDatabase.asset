          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Tinh linh l\u1EADp t\u1EE9c bay v\xE0o trong, g\u1EA7n nh\u01B0
            qu\xEAn s\u1EA1ch chuy\u1EC7n v\u1EEBa x\u1EA3y ra khi nh\xECn th\u1EA5y
            chi\u1EBFc gi\u01B0\u1EDDng l\u1EDBn ph\xEDa trong.\nRashad quay sang
            Lunen."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
