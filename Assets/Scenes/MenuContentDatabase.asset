          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Elio
          text: "Quen kh\xF4ng c\xF3 ngh\u0129a l\xE0 th\xEDch."
