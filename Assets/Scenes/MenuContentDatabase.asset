                m_PersistentCalls:
                  m_Calls: []
            - speaker: Aurelian
              text: "V\u1EDBi th\u1EF1c l\u1EF1c hi\u1EC7n t\u1EA1i, con c\xF2n qu\xE1
                y\u1EBFu \u0111\u1EC3 ti\u1EBFp nh\u1EADn H\u1ECFa \u1EA4n."
