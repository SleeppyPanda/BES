              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Elio
              text: "\u0110i th\xF4i. Ta s\u1EBD \u0111\u01B0a c\xE1c ng\u01B0\u01A1i
                v\xE0o th\xE0nh."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Lunen nh\xECn Ho\xE0ng th\xE0nh Akherat \u0111ang r\u1EF1c s\xE1ng
                d\u01B0\u1EDBi \xE1nh ho\xE0ng h\xF4n. H\u1ECD v\u1ED1n ch\u1EC9
                l\u1EA7n theo manh m\u1ED1i c\u1EE7a chi\u1EBFc v\xF2ng, nh\u01B0ng
                gi\u1EDD l\u1EA1i v\xF4 t\xECnh g\u1EB7p ch\xEDnh ho\xE0ng t\u1EED
                c\u1EE7a v\xF9ng \u0111\u1EA5t n\xE0y \u2014 m\u1ED9t ng\u01B0\u1EDDi
                m\xE0 \u0111\xE1m ma v\u1EADt r\xF5 r\xE0ng \u0111ang c\u1ED1 truy
                s\xE1t."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "C\u1EADu nh\xECn chi\u1EBFc v\xF2ng tr\xEAn c\u1ED5 tay.\nC\xF3
                l\u1EBD vi\u1EC7c \u0111\u1EB7t ch\xE2n v\xE0o Akherat s\u1EBD \u0111\u01B0a
                h\u1ECD \u0111\u1EBFn g\u1EA7n c\xE2u tr\u1EA3 l\u1EDDi h\u01A1n
                nh\u1EEFng g\xEC c\u1EADu t\u1EEBng ngh\u0129."
