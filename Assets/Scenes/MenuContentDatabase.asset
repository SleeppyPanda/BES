              m_Calls: []
        - speaker: Aurelian
          text: "Ta \u0111\xE3 n\xF3i th\xEC t\u1EE9c l\xE0 cho ph\xE9p."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
