          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "G\u1EA7n nh\u01B0 to\xE0n b\u1ED9 ng\u01B0\u1EDDi d\xE2n trong Ho\xE0ng
            th\xE0nh \u0111\u1EC1u s\u1EBD t\u1EDBi."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
