              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "M\u1ED9t b\xF3ng ng\u01B0\u1EDDi \u0111\xE1p xu\u1ED1ng tr\u01B0\u1EDBc
                m\u1EB7t c\u1EADu.\nAurelian.\nNg\u1ECDn l\u1EEDa bao quanh b\xE0
                r\u1EF1c s\xE1ng \u0111\u1EBFn m\u1EE9c to\xE0n b\u1ED9 nh\u1EEFng
                ma v\u1EADt c\xF2n l\u1EA1i trong qu\u1EA3ng tr\u01B0\u1EDDng \u0111\u1ED3ng
                lo\u1EA1t ch\u1EEFng l\u1EA1i."
