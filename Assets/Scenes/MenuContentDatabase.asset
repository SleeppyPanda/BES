          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Gi\u1ECDng Rashad v\u1EABn b\xECnh t\u0129nh, nh\u01B0ng ho\xE0n
            to\xE0n kh\xF4ng c\xF2n v\u1EBB th\xE2n thi\u1EC7n ban n\xE3y."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
