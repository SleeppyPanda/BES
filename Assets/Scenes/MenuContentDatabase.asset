          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Tinh Linh
          text: "B\u1ECDn t\xF4i \u0111\xE3 n\xF3i r\u1ED3i. Ch\u1EC9 l\xE0 t\xECnh
            c\u1EDD g\u1EB7p nhau."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
