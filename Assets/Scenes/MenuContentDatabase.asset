    - id: chapter_1_stage_7
      title: "Mong ng\u1ECDn l\u1EEDa v\u0129nh h\u1EB1ng v\u0129nh vi\u1EC5n b\u1EA3o
        h\u1ED9 ch\xFAng ta"
      description: "Lunen r\u1EDDi Akherat trong l\u1EDDi ti\u1EC5n bi\u1EC7t c\u1EE7a
        Elio v\xE0 nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n m\u1EDBi, kh\xE9p l\u1EA1i
        ch\u01B0\u01A1ng \u0111\u1EA7u c\u1EE7a ng\u1ECDn l\u1EEDa sa m\u1EA1c."
      preview: {fileID: 0}
      energyCost: 10
      preBattleDialogue:
        id: chapter_1_stage_7_story
        title: "Mong ng\u1ECDn l\u1EEDa v\u0129nh h\u1EB1ng v\u0129nh vi\u1EC5n b\u1EA3o
          h\u1ED9 ch\xFAng ta"
        summary: "Lunen r\u1EDDi Akherat trong l\u1EDDi ti\u1EC5n bi\u1EC7t c\u1EE7a
          Elio v\xE0 nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n m\u1EDBi, kh\xE9p l\u1EA1i
          ch\u01B0\u01A1ng \u0111\u1EA7u c\u1EE7a ng\u1ECDn l\u1EEDa sa m\u1EA1c."
        beats:
        - speaker: "C\u1EA3nh 7"
          text: "Mong ng\u1ECDn l\u1EEDa v\u0129nh h\u1EB1ng v\u0129nh vi\u1EC5n
            b\u1EA3o h\u1ED9 ch\xFAng ta"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "S\xE1ng s\u1EDBm.\nC\u1ED5ng ph\xEDa \u0110\xF4ng c\u1EE7a Akherat
            v\u1EEBa m\u1EDF. \xC1nh m\u1EB7t tr\u1EDDi \u0111\u1EA7u ng\xE0y tr\u1EA3i
            d\xE0i tr\xEAn con \u0111\u01B0\u1EDDng d\u1EABn ra kh\u1ECFi Ho\xE0ng
            th\xE0nh.\nLunen v\xE0 Tinh Linh \u0111\xE3 chu\u1EA9n b\u1ECB h\xE0nh
            l\xFD.\nNh\u01B0ng khi t\u1EDBi c\u1ED5ng th\xE0nh, hai ng\u01B0\u1EDDi
            l\u1EADp t\u1EE9c d\u1EEBng l\u1EA1i."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
