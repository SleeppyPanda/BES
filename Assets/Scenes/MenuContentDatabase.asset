          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Lunen
          text: "Ng\xE0i cho ph\xE9p t\xF4i v\xE0o \u0111\xF3?"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
