          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "Ta kh\xF4ng cho ph\xE9p Lunen t\u1EF1 do ti\u1EBFp c\u1EADn nh\u1EEFng
            th\u1EE9 kh\xF4ng thu\u1ED9c ph\u1EA1m vi c\u1EA7n thi\u1EBFt."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
