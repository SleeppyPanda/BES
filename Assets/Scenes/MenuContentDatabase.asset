              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "\xD4ng nh\xECn h\u1ECDc tr\xF2.\nCu\u1ED1i c\xF9ng quay sang
                Rashad."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
