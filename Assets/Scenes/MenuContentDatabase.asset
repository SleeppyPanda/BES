          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Thi\u1EBFu ni\xEAn nh\xECn con m\xE8o \u0111ang n\u1EB1m tr\xEAn
            vai m\xECnh, r\u1ED3i l\u1EA1i nh\xECn chi\u1EBFc v\xF2ng trong tay Lunen.
            Sau v\xE0i gi\xE2y im l\u1EB7ng, d\u01B0\u1EDDng nh\u01B0 c\u1EADu cu\u1ED1i
            c\xF9ng c\u0169ng hi\u1EC3u \u0111\u01B0\u1EE3c to\xE0n b\u1ED9 s\u1EF1
            vi\u1EC7c. Hai ng\u01B0\u1EDDi tr\u01B0\u1EDBc m\u1EB7t kh\xF4ng h\u1EC1
            ch\u1EE7 \u0111\u1ED9ng x\xE2m nh\u1EADp hay t\xECm c\xE1ch ti\u1EBFp
            c\u1EADn m\xECnh; h\u1ECD ch\u1EC9 \u0111\u01A1n gi\u1EA3n l\xE0 \u0111u\u1ED5i
            theo con m\xE8o \u0111\xE3 l\u1EA5y m\u1EA5t \u0111\u1ED3 c\u1EE7a h\u1ECD.\nCu\u1ED1i
            c\xF9ng, thi\u1EBFu ni\xEAn kh\u1EBD th\u1EDF ra."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
