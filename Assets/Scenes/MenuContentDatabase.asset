          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "V\xE0 c\u0169ng s\u1EBD c\xF3 k\u1EBB ch\u1EC9 mu\u1ED1n m\u1EA1ng
            c\u1EE7a con."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
