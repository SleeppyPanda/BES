          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: "\u0110\u1EA1i th\u1EA7n"
          text: "B\u1EC7 h\u1EA1, \u0110\u1EA1i Th\u01B0 Kh\u1ED1 l\u01B0u gi\u1EEF
            kh\xF4ng \xEDt t\xE0i li\u1EC7u quan tr\u1ECDng c\u1EE7a ho\xE0ng gia.
            \u0110\u1EC3 m\u1ED9t ng\u01B0\u1EDDi ngo\xE0i ti\u1EBFp c\u1EADn c\xF3
            l\u1EBD\u2014"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
