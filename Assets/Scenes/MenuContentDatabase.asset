        - speaker: Lunen
          text: "V\xE2ng. T\xF4i \u0111ang t\xECm hi\u1EC3u c\xE2u chuy\u1EC7n c\u1EE7a
            n\xF3."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
