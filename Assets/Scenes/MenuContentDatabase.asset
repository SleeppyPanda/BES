              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: "Ng\u01B0\u1EDDi d\xE2n"
              text: "Tr\u1EDDi m\u01B0a r\u1ED3i!"
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
