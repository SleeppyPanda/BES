        - speaker: Tinh Linh
          text: "Lunen! Chi\u1EBFc v\xF2ng!"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Con m\xE8o \u0111en \u0111\xE3 xu\u1EA5t hi\u1EC7n tr\u1EDF l\u1EA1i.\nN\xF3
            l\u1EB7ng l\u1EBD b\u01B0\u1EDBc ra kh\u1ECFi b\u1EE5i c\xE2y, chi\u1EBFc
            v\xF2ng ng\u1ECDc v\u1EABn m\u1EAFc tr\xEAn c\u1ED5. C\xF3 l\u1EBD trong
            l\xFAc hai ng\u01B0\u1EDDi giao tranh, n\xF3 \u0111\xE3 tr\u1ED1n \u1EDF
            m\u1ED9t n\u01A1i g\u1EA7n \u0111\xF3 v\xE0 gi\u1EDD m\u1EDBi ch\u1ECBu
            l\xF3 ra."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
