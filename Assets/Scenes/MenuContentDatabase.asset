              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "L\u1EA7n n\xE0y, nh\u1ECBp \u0111\u1ED9 c\u1EE7a h\u1ECD d\u1EA7n
                tr\u1EDF n\xEAn \u0103n \xFD m\u1ED9t c\xE1ch k\u1EF3 l\u1EA1. Lunen
                ng\u0103n nh\u1EEFng k\u1EBB c\u1ED1 \xE1p s\xE1t t\u1EEB hai b\xEAn,
                trong khi thi\u1EBFu ni\xEAn d\xF9ng ng\u1ECDn l\u1EEDa qu\xE9t s\u1EA1ch
                nh\u1EEFng ma v\u1EADt c\xF2n l\u1EA1i \u1EDF ph\xEDa tr\u01B0\u1EDBc.
                Tinh linh li\xEAn t\u1EE5c bay v\xF2ng quanh, v\u1EEBa c\u1EA3nh
                b\xE1o v\u1ECB tr\xED k\u1EBB \u0111\u1ECBch v\u1EEBa tr\xE1nh kh\u1ECFi
                nh\u1EEFng \u0111\xF2n t\u1EA5n c\xF4ng h\u1ED7n lo\u1EA1n."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
