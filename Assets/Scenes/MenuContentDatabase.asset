          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Con m\xE8o nh\xECn c\u1EADu, r\u1ED3i quay sang nh\xECn Lunen. Chi\u1EBFc
            \u0111u\xF4i \u0111ang phe ph\u1EA9y c\u0169ng t\u1EEB t\u1EEB h\u1EA1
            xu\u1ED1ng. Sau m\u1ED9t l\xE1t do d\u1EF1, n\xF3 nh\u1EA3y kh\u1ECFi
            vai ch\u1EE7 nh\xE2n, ng\u1EADm chi\u1EBFc v\xF2ng trong mi\u1EC7ng r\u1ED3i
            ch\u1EADm r\xE3i b\u01B0\u1EDBc t\u1EDBi tr\u01B0\u1EDBc m\u1EB7t Lunen."
