              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "\u0110\xFAng l\xFAc \u1EA5y, m\u1ED9t v\u1EE5 n\u1ED5 kh\xE1c
                x\u1EA3y ra \u1EDF khu v\u1EF1c ph\xEDa Nam.\nKhepraen nh\xECn sang.\nM\u1ED9t
                l\u01B0\u1EE3ng l\u1EDBn ma v\u1EADt \u0111ang tr\xE0n v\u1EC1 n\u01A1i
                ng\u01B0\u1EDDi d\xE2n s\u01A1 t\xE1n.\nElio ch\u1ED1ng ki\u1EBFm
                \u0111\u1EE9ng d\u1EADy."
