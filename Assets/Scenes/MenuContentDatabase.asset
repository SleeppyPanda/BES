          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Lunen
          text: "Nghe gi\u1ED1ng tr\u1ED1n vi\u1EC7c."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 0
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Elio
          text: "Ng\u01B0\u01A1i m\u1EDBi t\u1EDBi Akherat ch\u01B0a \u0111\u1EA7y
            m\u1ED9t ng\xE0y m\xE0 \u0111\xE3 b\u1EAFt \u0111\u1EA7u hi\u1EC3u ta
            r\u1ED3i \u0111\u1EA5y."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Lunen b\u1EADt c\u01B0\u1EDDi.\nY\u1EBFn ti\u1EC7c k\u1EBFt th\xFAc
            kh\xE1 mu\u1ED9n. Khi kh\xE1ch \u0111\xE3 l\u1EA7n l\u01B0\u1EE3t r\u1EDDi
            kh\u1ECFi \u0111\u1EA1i \u0111i\u1EC7n, Elio c\u0169ng chu\u1EA9n b\u1ECB
            c\xE1o lui."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "Elio. Ta c\u1EA7n n\xF3i chuy\u1EC7n ri\xEAng v\u1EDBi con ."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Elio
          text: "V\xE2ng, th\u01B0a m\u1EABu th\xE2n."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "Con bi\u1EBFt h\xF4m nay m\xECnh sai \u1EDF \u0111\xE2u ch\u1EE9?"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Elio
          text: "Con \u0111\xE3 \u0111\u01B0a m\u1ED9t ng\u01B0\u1EDDi ch\u01B0a
            r\xF5 lai l\u1ECBch v\xE0o ho\xE0ng cung khi ch\u01B0a x\xE1c minh \u0111\u1EA7y
            \u0111\u1EE7."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "C\xF2n g\xEC n\u1EEFa?"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Elio
          text: "Con \u0111\u1EC3 ph\xE1n \u0111o\xE1n c\xE1 nh\xE2n \u1EA3nh h\u01B0\u1EDFng
            \u0111\u1EBFn quy\u1EBFt \u0111\u1ECBnh."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "T\u1ED1t."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "\xCDt nh\u1EA5t con v\u1EABn nh\xECn ra \u0111\u01B0\u1EE3c."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Elio
          text: "Xin m\u1EABu th\xE2n ch\u1EC9 d\u1EA1y."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "Ta kh\xF4ng c\u1EA7n con xin l\u1ED7i."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "Ta c\u1EA7n con nh\u1EDB r\u1EB1ng t\u1EEB khi \u0111\u01B0\u1EE3c
            l\u1EF1a ch\u1ECDn l\xE0m ng\u01B0\u1EDDi k\u1EBF th\u1EEBa, m\u1ED7i
            quy\u1EBFt \u0111\u1ECBnh c\u1EE7a con \u0111\u1EC1u kh\xF4ng c\xF2n
            ch\u1EC9 thu\u1ED9c v\u1EC1 ri\xEAng con."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Elio
          text: "V\xE2ng."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "Sau n\xE0y s\u1EBD c\xF3 r\u1EA5t nhi\u1EC1u ng\u01B0\u1EDDi mu\u1ED1n
            ti\u1EBFp c\u1EADn con."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
