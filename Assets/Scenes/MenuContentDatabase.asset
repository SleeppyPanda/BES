              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "C\u1EADu b\u1EADt c\u01B0\u1EDDi r\u1ED3i xoay ng\u01B0\u1EDDi
                v\u1EC1 ph\xEDa con \u0111\u01B0\u1EDDng d\u1EABn ra kh\u1ECFi r\u1EEBng."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
