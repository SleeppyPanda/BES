        - speaker: 
          text: "Rashad b\u1EADt c\u01B0\u1EDDi."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "N\u1EBFu c\xF4 g\u1EB7p ng\xE0i \u1EA5y r\u1ED3i, c\xF3 l\u1EBD
            c\xF4 s\u1EBD kh\xF4ng c\xF2n d\xF9ng t\u1EEB \u2018b\xECnh th\u01B0\u1EDDng\u2019
            n\u1EEFa \u0111\xE2u."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Ba ng\u01B0\u1EDDi v\u1EEBa n\xF3i chuy\u1EC7n v\u1EEBa ti\u1EBFp
            t\u1EE5c \u0111i s\xE2u v\xE0o cung \u0111i\u1EC7n. Kh\xF4ng kh\xED \u0111\xE3
            tho\u1EA3i m\xE1i h\u01A1n \u0111\xE1ng k\u1EC3, \u0111\u1EBFn m\u1EE9c
            tinh linh b\u1EAFt \u0111\u1EA7u h\u1ECFi Rashad \u0111\u1EE7 th\u1EE9
            t\u1EEB m\xF3n \u0103n trong th\xE0nh cho t\u1EDBi nh\u1EEFng b\u1EE9c
            t\u01B0\u1EE3ng ngo\xE0i qu\u1EA3ng tr\u01B0\u1EDDng.\nNh\u01B0ng khi
            h\u1ECD r\u1EBD qua m\u1ED9t h\xE0nh lang kh\xE1c, Rashad \u0111\u1ED9t
            nhi\xEAn ch\u1EADm b\u01B0\u1EDBc.\nPh\xEDa tr\u01B0\u1EDBc c\xF3 hai
            ng\u01B0\u1EDDi \u0111ang \u0111i t\u1EDBi."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Ng\u01B0\u1EDDi \u0111i \u0111\u1EA7u m\u1EB7c tr\u01B0\u1EDDng
            b\xE0o nghi l\u1EC5 c\u1EE7a H\u1ED9i \u0111\u1ED3ng T\u01B0 t\u1EBF.
            Nh\u1EEFng \u0111\u01B0\u1EDDng th\xEAu v\xE0ng ch\u1EA1y d\u1ECDc c\u1ED5
            \xE1o v\xE0 tay \xE1o, \u1EDF gi\u1EEFa ng\u1EF1c l\xE0 bi\u1EC3u t\u01B0\u1EE3ng
            ng\u1ECDn l\u1EEDa m\u1EB7t tr\u1EDDi. \u0110i ph\xEDa sau \xF4ng l\xE0
            m\u1ED9t thi\u1EBFu ni\xEAn nh\u1ECF tu\u1ED5i h\u01A1n, hai tay \xF4m
            m\u1ED9t ch\u1ED3ng t\xE0i li\u1EC7u cao g\u1EA7n che m\u1EA5t n\u1EEDa
            khu\xF4n m\u1EB7t.\nRashad d\u1EEBng l\u1EA1i."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
