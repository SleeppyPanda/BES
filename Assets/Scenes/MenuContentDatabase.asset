          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Lunen
          text: "T\xF4i kh\xF4ng ngh\u0129 \xF4ng \u1EA5y n\xF3i v\u1EC1 v\u0169
            kh\xED."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
