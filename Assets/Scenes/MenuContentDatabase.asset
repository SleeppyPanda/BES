          dialogue:
            id: chapter_1_scene_1_phase_2_trigger_3_dialogue
            title: "Combat - khi c\xF3 2 con qu\xE1i con \u0111\u01B0\u1EE3c tri\u1EC7u
              h\u1ED3i b\u1ECB ti\xEAu di\u1EC7t."
            summary: "ti\u1EBFp t\u1EE5c tr\u1EADn chi\u1EBFn v\u1EDBi 1 \u0111\u1ED3ng
              minh m\u1EDBi l\xE0 Aurelian trong team m\xECnh. v\u1ECB tr\xED s\u1EBD
              l\xE0 \u1EDF \xF4 th\u1EE9 3 v\u1EDBi hp = 100%."
            beats:
            - speaker: 
              text: "Lunen \xE9p Nephkar l\xF9i d\u1EA7n.\nNh\u01B0ng l\u01B0\u1EE3ng
                ma v\u1EADt xung quanh v\u1EABn ti\u1EBFp t\u1EE5c t\u0103ng.\nRamesses
                v\xE0 Kasim cu\u1ED1i c\xF9ng d\u1EABn qu\xE2n quay l\u1EA1i."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
