              m_Calls: []
        - speaker: 
          text: "Rashad nh\xECn c\u1EADu th\xEAm m\u1ED9t l\xFAc.\nV\u1EABn l\xE0
            \xE1nh m\u1EAFt c\u1EA3nh gi\xE1c \u1EA5y.\nNh\u01B0ng kh\xF4ng c\xF2n
            s\u1EAFc l\u1EA1nh nh\u01B0 khi l\u01B0\u1EE1i ki\u1EBFm v\u1EEBa ch\u0129a
