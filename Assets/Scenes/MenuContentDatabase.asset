              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Lunen
              text: "\u0110\u1EEBng m\u1EA5t t\u1EADp trung."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 0
              dimRight: 1
              layoutMode: 0
