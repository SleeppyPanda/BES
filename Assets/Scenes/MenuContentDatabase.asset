                  m_Calls: []
            - speaker: Elio
              text: "Th\u01B0a m\u1EABu th\xE2n, ng\u01B0\u1EDDi ch\u1EAFc ch\u1EE9?"
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Aurelian ch\u1EC9 nh\xECn c\u1EADu.\nElio l\u1EADp t\u1EE9c
                hi\u1EC3u m\xECnh kh\xF4ng c\u1EA7n h\u1ECFi l\u1EA1i."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Elio
              text: "...V\xE2ng."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "T\u1EBF Thi\xEAn \u0110\xE0i \u0111\u01B0\u1EE3c s\u1EEDa ch\u1EEFa
                nhanh ch\xF3ng.\nNg\u01B0\u1EDDi d\xE2n d\u1EA7n quay tr\u1EDF l\u1EA1i
                qu\u1EA3ng tr\u01B0\u1EDDng.\nL\u1EA7n n\xE0y, Aurelian tr\u1EF1c
                ti\u1EBFp b\u01B0\u1EDBc l\xEAn \u0111\xE0i t\u1EBF.\nElio \u0111\u1EE9ng
                ph\xEDa sau b\xE0."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "D\xF9 nh\u1EEFng v\u1EBFt th\u01B0\u01A1ng v\u1EABn c\xF2n \u0111au,
                c\u1EADu gi\u1EEF nguy\xEAn t\u01B0 th\u1EBF c\u1EE7a ng\u01B0\u1EDDi
                k\u1EBF th\u1EEBa.\nAurelian n\xE2ng hai tay.\nTo\xE0n b\u1ED9 nh\u1EEFng
                ng\u1ECDn l\u1EEDa quanh qu\u1EA3ng tr\u01B0\u1EDDng \u0111\u1ED3ng
                lo\u1EA1t b\xF9ng s\xE1ng."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Aurelian
              text: "H\u1EE1i ng\u1ECDn l\u1EEDa \u0111\xE3 soi s\xE1ng Akherat."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 0
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: Aurelian
              text: "H\u1EE1i v\xF9ng \u0111\u1EA5t \u0111\xE3 nu\xF4i d\u01B0\u1EE1ng
                ch\xFAng ta."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
