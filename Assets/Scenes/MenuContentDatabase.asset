            m_PersistentCalls:
              m_Calls: []
        - speaker: Rashad
          text: "Ng\u01B0\u1EDDi tuy\xEAn chi\u1EBFn v\u1EDBi m\u1EB7t tr\u1EDDi."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
