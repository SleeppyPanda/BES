              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Elio \u0111\u1EE9ng ph\xEDa sau nh\xECn Aurelian.\nTrong \xE1nh
                m\u1EAFt c\u1EADu kh\xF4ng c\xF3 s\u1EF1 ghen t\u1ECB.\nCh\u1EC9
                c\xF3 s\u1EF1 ng\u01B0\u1EE1ng m\u1ED9 g\u1EA7n nh\u01B0 tuy\u1EC7t
                \u0111\u1ED1i.\nLunen nh\xECn th\u1EA5y \u0111i\u1EC1u \u0111\xF3.\nC\xF3
                l\u1EBD \u0111\xE2y ch\xEDnh l\xE0 ng\u01B0\u1EDDi m\xE0 Elio lu\xF4n
                mu\u1ED1n tr\u1EDF th\xE0nh."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Nghi l\u1EC5 d\u1EA7n b\u01B0\u1EDBc t\u1EDBi ph\u1EA7n cu\u1ED1i.\nAurelian
                \u0111\u1EB7t tay l\xEAn trung t\xE2m T\u1EBF Thi\xEAn \u0110\xE0i.\nTrong
                kho\u1EA3nh kh\u1EAFc \u1EA5y, \xE1nh m\u1EAFt b\xE0 \u0111\u1ED9t
                nhi\xEAn d\u1EEBng l\u1EA1i.\nD\u01B0\u1EDBi l\u1EDBp \xE1nh s\xE1ng
                c\u1EE7a H\u1ECFa \u1EA4n, m\u1ED9t \u0111\u01B0\u1EDDng k\xFD t\u1EF1
                \u0111en r\u1EA5t nh\u1ECF v\u1EEBa l\xF3e l\xEAn gi\u1EEFa nh\u1EEFng
                khe \u0111\xE1."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
              leftCharacter: {fileID: 0}
              rightCharacter: {fileID: 0}
              dimLeft: 1
              dimRight: 1
              layoutMode: 0
              instantLayout: 0
              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
