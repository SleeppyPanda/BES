          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Lunen \u0111\u01B0a tay l\xEAn v\u0169 kh\xED."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Nh\u1EEFng sinh v\u1EADt d\u1ECB d\u1EA1ng l\u1EA7n l\u01B0\u1EE3t
            b\u01B0\u1EDBc ra kh\u1ECFi b\xF3ng t\u1ED1i. C\u01A1 th\u1EC3 ch\xFAng
            \u0111\u01B0\u1EE3c bao ph\u1EE7 b\u1EDFi l\u1EDBp gi\xE1p \u0111en ch\xE1y
            s\xE9m, nh\u1EEFng khe n\u1EE9t \u0111\u1ECF r\u1EF1c ch\u1EA1y d\u1ECDc
            th\xE2n nh\u01B0 dung nham \u0111ang ch\u1EA3y b\xEAn d\u01B0\u1EDBi
            l\u1EDBp da. Trong tay ch\xFAng l\xE0 nh\u1EEFng l\u01B0\u1EE1i v\u0169
            kh\xED th\xF4 r\xE1p, d\xEDnh \u0111\u1EA7y th\u1EE9 d\u1ECBch \u0111en
            s\u1EABm."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
