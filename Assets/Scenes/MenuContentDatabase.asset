              m_Calls: []
        - speaker: 
          text: "Lunen th\xE1o chi\u1EBFc v\xF2ng r\u1ED3i \u0111\u01B0a cho b\xE0.\nAurelian
            quan s\xE1t n\xF3 kh\xE1 l\xE2u."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
