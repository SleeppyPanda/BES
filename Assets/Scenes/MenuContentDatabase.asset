          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Con m\xE8o gi\u1EADt m\xECnh b\u1ECF ch\u1EA1y.\nN\xF3 ph\xF3ng
            qua n\u1EC1n \u0111\u1EA5t, l\xE1ch gi\u1EEFa hai th\xE2n c\xE2y r\u1ED3i
            b\u1EA5t ng\u1EDD \u0111\u1ED5i h\u01B0\u1EDBng, ch\u1EA1y th\u1EB3ng
            v\u1EC1 ph\xEDa thi\u1EBFu ni\xEAn. Ch\u1EC9 trong ch\u1EDBp m\u1EAFt,
            n\xF3 \u0111\xE3 nh\u1EA3y l\xEAn ch\xE2n c\u1EADu, b\xE1m v\xE0o v\u1EA1t
            \xE1o r\u1ED3i leo m\u1ED9t m\u1EA1ch l\xEAn vai."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Thi\u1EBFu ni\xEAn theo ph\u1EA3n x\u1EA1 \u0111\u01B0a tay \u0111\u1EE1
            l\u1EA5y n\xF3.\nCon m\xE8o cu\u1ED9n tr\xF2n b\xEAn c\u1ED5 c\u1EADu,
            chi\u1EBFc \u0111u\xF4i qu\u1EA5n nh\u1EB9 quanh c\xE1nh tay nh\u01B0
            th\u1EC3 v\u1EEBa t\xECm \u0111\u01B0\u1EE3c n\u01A1i an to\xE0n nh\u1EA5t.\nTinh
            linh ch\u1EA1y t\u1EDBi n\u01A1i, t\u1EE9c \u0111\u1EBFn m\u1EE9c d\u1EADm
            ch\xE2n."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
