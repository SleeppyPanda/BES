          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Aurelian
          text: "Menkara s\u1EBD gi\xE1m s\xE1t vi\u1EC7c tra c\u1EE9u."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
