          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Tinh Linh
          text: "Ki\u1EC3u m\u1ED9t ng\xF4i \u0111\u1EC1n tr\xEAn m\xE2y, th\u1EA7n
            gi\u1EDBi, ho\u1EB7c n\u01A1i ng\u01B0\u1EDDi b\xECnh th\u01B0\u1EDDng
            kh\xF4ng th\u1EC3 t\u1EDBi ch\u1EB3ng h\u1EA1n."
