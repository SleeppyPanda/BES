              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Nephkar xu\u1EA5t hi\u1EC7n ph\xEDa sau."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
