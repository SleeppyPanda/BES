            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Thay v\xEC \u0111\u1EE9ng l\xEAn ngay, Lunen \u0111\u01B0a tay xoa
            nh\u1EB9 l\xEAn \u0111\u1EA7u con m\xE8o."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Lunen
          text: "L\u1EA7n sau \u0111\u1EEBng l\u1EA5y \u0111\u1ED3 c\u1EE7a ng\u01B0\u1EDDi
            kh\xE1c n\u1EEFa nh\xE9."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 0
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Con m\xE8o ng\u1EA9ng \u0111\u1EA7u nh\xECn c\u1EADu. M\u1ED9t tho\xE1ng
            sau, n\xF3 ch\u1EE7 \u0111\u1ED9ng b\u01B0\u1EDBc l\u1EA1i g\u1EA7n r\u1ED3i
            d\u1EE5i \u0111\u1EA7u v\xE0o l\xF2ng b\xE0n tay Lunen, th\u1EADm ch\xED
            c\xF2n nheo m\u1EAFt \u0111\u1EA7y th\xEDch th\xFA khi \u0111\u01B0\u1EE3c
            vu\u1ED1t ve.\nThi\u1EBFu ni\xEAn h\u01A1i kh\u1EF1ng l\u1EA1i."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: ???
          text: "...L\u1EA1 th\u1EADt."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Lunen
          text: "C\xF3 chuy\u1EC7n g\xEC sao?"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 0
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Thi\u1EBFu ni\xEAn nh\xECn con m\xE8o \u0111ang qu\u1EA5n l\u1EA5y
            ch\xE2n Lunen."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: ???
          text: "N\xF3 kh\xF4ng g\u1EA7n ng\u01B0\u1EDDi l\u1EA1."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Tinh Linh
          text: "N\xF3 v\u1EEBa c\u01B0\u1EDBp \u0111\u1ED3 c\u1EE7a ng\u01B0\u1EDDi
            l\u1EA1 m\xE0."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: ???
          text: "Ta n\xF3i l\xE0 kh\xF4ng th\xE2n v\u1EDBi ng\u01B0\u1EDDi l\u1EA1,
            kh\xF4ng ph\u1EA3i kh\xF4ng g\xE2y r\u1EAFc r\u1ED1i cho ng\u01B0\u1EDDi
            l\u1EA1."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Tinh linh ngh\u1EB9n l\u1EDDi, c\xF2n Lunen kh\xF4ng nh\u1ECBn \u0111\u01B0\u1EE3c
            b\u1EADt c\u01B0\u1EDDi. Thi\u1EBFu ni\xEAn c\u0169ng kh\u1EBD cong kh\xF3e
            m\xF4i. S\u1EF1 c\u0103ng th\u1EB3ng gi\u1EEFa h\u1ECD cu\u1ED1i c\xF9ng
            \u0111\xE3 th\u1EF1c s\u1EF1 tan \u0111i.\nC\u1EADu nh\xECn Lunen th\xEAm
            m\u1ED9t l\xFAc, r\u1ED3i \xE1nh m\u1EAFt chuy\u1EC3n sang thanh v\u0169
            kh\xED c\u1EE7a m\xECnh.\nNh\u01B0ng ngay l\xFAc \u0111\xF3, m\u1ED9t
            ti\u1EBFng g\u1EA7m tr\u1EA7m \u0111\u1EE5c b\u1EA5t ng\u1EDD vang l\xEAn
            t\u1EEB s\xE2u trong khu r\u1EEBng."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "N\u1EE5 c\u01B0\u1EDDi tr\xEAn khu\xF4n m\u1EB7t thi\u1EBFu ni\xEAn
            l\u1EADp t\u1EE9c bi\u1EBFn m\u1EA5t.\nKh\xF4ng kh\xED xung quanh b\u1ED7ng
            tr\u1EDF n\xEAn n\u1EB7ng n\u1EC1. Nh\u1EEFng b\u1EE5i c\xE2y ph\xEDa
            xa rung l\xEAn d\u1EEF d\u1ED9i, t\u1EEBng \u0111\xE0n chim ho\u1EA3ng
            lo\u1EA1n bay kh\u1ECFi t\xE1n l\xE1. Ch\u1EC9 trong v\xE0i gi\xE2y,
            h\xE0ng lo\u1EA1t b\xF3ng \u0111en b\u1EAFt \u0111\u1EA7u xu\u1EA5t hi\u1EC7n
            gi\u1EEFa nh\u1EEFng th\xE2n c\xE2y."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Tinh Linh
          text: Lunen...
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
