        - speaker: 
          text: "C\u1EADu nh\xECn con m\xE8o tr\xEAn vai m\xECnh r\u1ED3i nh\xECn
            tinh linh. C\xF4 b\xE9 ch\u1EC9 th\u1EB3ng v\xE0o chi\u1EBFc v\xF2ng."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
