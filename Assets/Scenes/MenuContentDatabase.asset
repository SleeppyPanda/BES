              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "Sinh v\u1EADt \u0111\u1ED5 xu\u1ED1ng.\nKhu r\u1EEBng cu\u1ED1i
                c\xF9ng c\u0169ng tr\u1EDF l\u1EA1i y\xEAn t\u0129nh."
