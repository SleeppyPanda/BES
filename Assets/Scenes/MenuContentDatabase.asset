              castActions: []
              characterPlacements: []
              characterMovements: []
              characterVisuals: []
              onBeatStarted:
                m_PersistentCalls:
                  m_Calls: []
            - speaker: 
              text: "\u0110\xF3 ch\xEDnh x\xE1c l\xE0 \u0111i\u1EC1u Nephkar mu\u1ED1n.\nM\u1ED7i
                khi Elio t\xECm \u0111\u01B0\u1EE3c c\u01A1 h\u1ED9i ti\u1EBFn g\u1EA7n
                b\xE0 ta, m\u1ED9t ti\u1EBFng la h\xE9t kh\xE1c l\u1EA1i vang l\xEAn.\nM\u1ED9t
                con ma v\u1EADt lao v\u1EC1 ph\xEDa th\u01B0\u1EDDng d\xE2n.\nElio
                l\u1EADp t\u1EE9c chuy\u1EC3n h\u01B0\u1EDBng."
