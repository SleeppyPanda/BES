            m_PersistentCalls:
              m_Calls: []
        - speaker: 
          text: "Gi\u1ECDng n\xF3i ho\xE0n to\xE0n l\u1ECBch s\u1EF1.\nNh\u01B0ng
            Lunen kh\xF4ng hi\u1EC3u v\xEC sao l\u1EA1i c\u1EA3m th\u1EA5y c\xE2u
            n\xF3i \u1EA5y ch\u1EB3ng gi\u1ED1ng m\u1ED9t l\u1EDDi khen."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
