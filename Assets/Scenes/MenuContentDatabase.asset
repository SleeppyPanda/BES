          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Lunen
          text: "C\u1EA7u m\u01B0a?"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 0
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Elio
          text: "\u1EEA. M\u1ED9t trong nh\u1EEFng l\u1EC5 h\u1ED9i quan tr\u1ECDng
            c\u1EE7a Akherat."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Lunen
          text: "V\u01B0\u01A1ng qu\u1ED1c c\u1EE7a H\u1ECFa th\u1EA7n l\u1EA1i c\u1EA7u
            m\u01B0a sao?"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 0
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Elio
          text: "Ng\u1ECDn l\u1EEDa c\xF3 m\u1EA1nh \u0111\u1EBFn \u0111\xE2u c\u0169ng
            kh\xF4ng th\u1EC3 thay th\u1EBF n\u01B0\u1EDBc."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Elio
          text: "Akherat t\u1ED3n t\u1EA1i gi\u1EEFa sa m\u1EA1c. Ng\u01B0\u1EDDi
            d\xE2n n\u01A1i \u0111\xE2y hi\u1EC3u gi\xE1 tr\u1ECB c\u1EE7a t\u1EEBng
            gi\u1ECDt n\u01B0\u1EDBc h\u01A1n b\u1EA5t k\u1EF3 ai."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Lunen
          text: "Ng\xE0y mai s\u1EBD t\u1ED5 ch\u1EE9c sao?"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 0
          dimRight: 1
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Elio
          text: "Ch\u01B0a. Nh\u01B0ng th\xE0nh ph\u1ED1 s\u1EBD b\u1EAFt \u0111\u1EA7u
            chu\u1EA9n b\u1ECB."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Elio
          text: "N\u1EBFu ng\u01B0\u01A1i v\xE0 Tinh Linh mu\u1ED1n, ng\xE0y mai
            ta c\xF3 th\u1EC3 \u0111\u01B0a hai ng\u01B0\u1EDDi \u0111i xem."
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 1
          dimRight: 0
          layoutMode: 0
          instantLayout: 0
          castActions: []
          characterPlacements: []
          characterMovements: []
          characterVisuals: []
          onBeatStarted:
            m_PersistentCalls:
              m_Calls: []
        - speaker: Lunen
          text: "Ho\xE0ng t\u1EED r\u1EA3nh \u0111\u1EBFn v\u1EADy sao?"
          background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
          leftCharacter: {fileID: 0}
          rightCharacter: {fileID: 0}
          dimLeft: 0
          dimRight: 1
          layoutMode: 0
