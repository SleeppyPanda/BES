            - speaker: Tinh Linh
              text: "Nghe ch\u1EEF \u2018ngay l\xFAc n\xE0y\u2019 \u0111\xE1ng nghi
                qu\xE1 \u0111\u1EA5y."
              background: {fileID: 21300000, guid: 44117fbeb6b31014ea4da2b5af930269, type: 3}
